# flair project file
Version: 300
Mode: fluka
Title: Simul for Ilias
md5: b2e6e24c87e34fb78c767a8d96662daa
Input:
TITLE
	Particle production at ESSnuSB target
GLOBAL ,,,, 1.0 1.0
#define trg_len 78
#define trg_rad 1.5
!#define horn_len 100
!#define horn_rad 100
#define horn 1000
#define tline 3000
#define pstraight 8000
#define neardet 13000
DEFAULTS NEW-DEFA
*2.5 GeV/c
BEAM PROTON 2.5,,, 0 0
*# --- initialisation parameters: 1) if =1 assume perfect focusing
USRICALL , 1
BEAMPOS , 0.0 0.0 0.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS EVAPORAT 3.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS COALESCE 1.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS EM-DISSO 2.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS IONBRPAI 1.
!IONTRANS , HEAVYION
EMF EMF-OFF
!EMFCUT , 1E-2 1E-2,,, @LASTREG
!EMFCUT PROD-CUT 1E-5 1E-5,, BERYLLIU BERYLLIU 1.
!BIASING PRINT 1.,, 1.0 T2HEAD
!BIASING PRINT 0.0,, 5.0 T2INSHLD
!BIASING PRINT 1.,, 10.0 T2COLL
!BIASING PRINT 1.,, 10.0 AIRBEFB3
!BIASING PRINT 1.,, 100.0 B3TVac
!BIASING PRINT 1.,, 100.0 AIRBEFB2
!BIASING PRINT 1.,, 100.0 B2B3Spec
!BIASING PRINT 1.,, 100.0 AIRBEFD
!BIASING PRINT 1.,, 100.0 DEGR
!BIASING PRINT 1.,, 100.0 AIRAFTER
!BIASING PRINT 1.,, 100.0 NA61exp
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
GEOBEGIN COMBNAME
* Black body
SPH world 0.0 0.0 0.0 100000.0
* Void sphere
SPH around 0.0 0.0 0.0 90000.0
!RPP world -300. 300. -300 300. -500. 40000.
!RPP around -150 150. -150. 150 -300. 10000
RCC target 0.0 0.0 0 0.0 0.0 =trg_len =trg_rad
RCC trg_cyl 0.0 0.0 -1 0 0 =trg_len+2 =trg_rad+1
RCC trg_cylo 0.0 0.0 -2 0 0 =trg_len+4 =trg_rad+2
!ZCC horn_cyl 0.0 0.0 $horn_rad
!XYP pl_up -2
!XYP pl_dow0 =trg_len+2
!XYP pl_dow1 $horn_len
RPP trg_end -30 30 -30 30 =trg_len+5 =trg_len+6
RPP horn_end -30 30 -30 30 =horn =horn+1
RPP tline -30 30 -30 30 =tline =tline+1
RPP prods -30 30 -30 30 =pstraight =pstraight+1
RPP neardet -500 500 -500 500 =neardet =neardet+1
END
* Black hole
REGION BLKBODY 5
	+world -around
* Void around
REGION VOID 5
	+around -trg_cylo -trg_end -horn_end -tline -prods -neardet | +trg_cyl -target 
REGION TARGET 5
	+target
!REGION HORN 5
	+horn_cyl -pl_up +pl_dow1 -(+trg_cyl -pl_up +pl_dow0)
REGION TBOX 5
	+trg_cylo -trg_cyl 
REGION TRGEND 5
	+trg_end
REGION HORNEND 5
	+horn_end
	@select=1
REGION TLINEEND 5
	+tline 
REGION PRODS 5
	+prods
REGION NEARDET 5
	+neardet
END
GEOEND
!LOW-MAT CARBON GRAPHITE 6. -3. 296.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!MATERIAL AIR,,, 0.001225
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!MATERIAL AIR2,,, 0.001225
MAT-PROP USERDIRE 1.,,, BLCKHOLE @LASTMAT
!COMPOUND AIR -0.78 NITROGEN -0.21 OXYGEN -0.01 ARGON
!COMPOUND AIR2 -0.78 NITROGEN -0.21 OXYGEN -0.01 ARGON
!MATERIAL GRAPHITE 6.,, 1.78
!STERNHEI GRAPHITE 3.155 0.048 2.5387 0.20762 2.9532 0.14
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , VACUUM VOID
ASSIGNMA , TITANIUM TARGET
ASSIGNMA , VACUUM TBOX
ASSIGNMA , VACUUM TRGEND
ASSIGNMA , VACUUM HORNEND
ASSIGNMA , VACUUM TLINEEND
ASSIGNMA , VACUUM PRODS
ASSIGNMA , VACUUM NEARDET
!USRBIN Beampart 10. BEAMPART -21 30. 30. =horn+1 -30. -30. =horn 60. 60. 1
!USRBIN Pions-Trg 10. PION+ -80 30. 30. =trg_len+1 -30. -30. =trg_len 200. 200. \
	 1.
!USRBIN Pions-Horn 10. PION+ -81 30. 30. =horn+1 -30. -30. =horn 200. 200. 1.
!USRBIN Pions-Tline 10. PION+ -82 30. 30. =tline+1 -30. -30. =tline 200. 200. 1.
!USRBIN Pions-Prods 10. PION+ -83 30. 30. =pstraight+1 -30. -30. =pstraight 200. \
	 200. 1.
!USRBIN Muons-Trg 10. MUON+ -90 30. 30. =trg_len+1 -30. -30. =trg_len 200. 200. \
	 1
!USRBIN Muons-Horn 10. MUON+ -91 30. 30. =horn+1 -30. -30. =horn 200. 200. 1
!USRBIN Muons-Tline 10. MUON+ -92 30. 30. =tline+1 -30. -30. =tline 200. 200. 1
!USRBIN Muons-Prods 10 MUON+ -92 30. 30. =pstraight+1 -30. -30. =pstraight 200. \
	 200. 1
!USRYIELD Yield 202 -UNKNOWN -22 -1 -2
!USRTRACK PiDET0,, PION+ -23 HORNEND,, 100 2 0.001
!USRTRACK PiDET10,, PION+ -24 TLINEEND,, 100 2 0.001
!USRTRACK PiDET20,, PION+ -23 PRODS,, 100 2 0.001
!USRTRACK PiDET30,, PION+ -25 NEARDET,, 100 2 0.001
!USRTRACK muDET0,, MUON+ -23 HORNEND,, 100 2 0.001
!USRTRACK muDET10,, MUON+ -23 TLINEEND,, 100 2 0.001
!USRTRACK muDET20,, MUON+ -23 PRODS,, 100 2 0.001
!USRTRACK muDET30,, MUON+ -23 NEARDET,, 100 2 0.001
!AUXSCORE , USRYIELD -20808200,, NA61Be NA61Be
USRBDX ProtTarg 99 BEAMPART -49 VOID TRGEND 900 3.0 0.001 100
USRBDX PITarget 99 PION+ -50 VOID TRGEND 900 1.5 0.001 100
USRBDX PIHorn 99 PION+ -51 VOID HORNEND 900 1.5 0.001 100
USRBDX PITline 99 PION+ -52 VOID TLINEEND 900 1.5 0.001 100
USRBDX PIPstr 99 PION+ -53 VOID PRODS 900 1.5 0.001 100
USRBDX MuTarg 99 MUON+ -60 VOID TRGEND 900 1.5 0.001 100
USRBDX MuHorn 99 MUON+ -61 VOID HORNEND 900 1.5 0.001 100
USRBDX MuTline 99 MUON+ -62 VOID TLINEEND 900 1.5 0.001 100
USRBDX MuPstr 99 MUON+ -63 VOID PRODS 900 1.5 0.001 100
OPEN UNKNOWN 95.
	target_pprod.dat
!OPEN UNKNOWN 96.
	befdeg.dat
!OPEN UNKNOWN 97.
	na61exp_air.dat
!OPEN UNKNOWN 98
	BEFTAX_air.dat
RANDOMIZ
START , 20000.,,,, 0.0
STOP
EndInput

Submit: Local
Page: Plot
plotengine: Gnuplot
Compile: ESS.exe
	source: ['usrmed_fprod.f', 'usrini.f']
End

# Run information
Run: <default>
	Exe:      ESS.exe
	Last:     10
	Status:   3
	StartRun: 1730540972.346426
	queue:    Local
	open:     1
End
