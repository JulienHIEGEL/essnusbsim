# flair project file
Version: 300
Mode: fluka
Title: Simul for Ilias
md5: 55112615c187321e5d85a5a9035e3a75
Input:
TITLE
	Simul for Ilias
GLOBAL ,,,, 1.0 1.0
#define trg_len 78
#define trg_rad 1.5
#define horn_len 100.0
#define horn_rad 100.0
DEFAULTS NEW-DEFA
*2 GeV/c
BEAM PROTON 2.0,,, 0 0
*# --- initialisation parameters: 1) if =1 assume perfect focusing
USRICALL , 1
BEAMPOS , 0.0 0.0 0.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS EVAPORAT 3.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS COALESCE 1.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS EM-DISSO 2.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!PHYSICS IONBRPAI 1.
!IONTRANS , HEAVYION
EMF EMF-OFF
!EMFCUT , 1E-2 1E-2,,, @LASTREG
!EMFCUT PROD-CUT 1E-5 1E-5,, BERYLLIU BERYLLIU 1.
!BIASING PRINT 1.,, 1.0 T2HEAD
!BIASING PRINT 0.0,, 5.0 T2INSHLD
!BIASING PRINT 1.,, 10.0 T2COLL
!BIASING PRINT 1.,, 10.0 AIRBEFB3
!BIASING PRINT 1.,, 100.0 B3TVac
!BIASING PRINT 1.,, 100.0 AIRBEFB2
!BIASING PRINT 1.,, 100.0 B2B3Spec
!BIASING PRINT 1.,, 100.0 AIRBEFD
!BIASING PRINT 1.,, 100.0 DEGR
!BIASING PRINT 1.,, 100.0 AIRAFTER
!BIASING PRINT 1.,, 100.0 NA61exp
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
GEOBEGIN COMBNAME
* Black body
!SPH world 0.0 0.0 0.0 1200.0
* Void sphere
!SPH around 0.0 0.0 0.0 1000.0
RPP world -300. 300. -300 300. -500. 40000.
RPP around -150 150. -150. 150 -300. 10000
RCC target 0.0 0.0 0,,, =trg_len =trg_rad
ZCC trg_cyl 0.0 0.0 =trg_rad+2
ZCC horn_cyl 0.0 0.0 =horn_rad
XYP pl_up -2
XYP pl_dow0 =trg_len+2
XYP pl_dow1 =horn_len
RCC det0 0 0 =horn_len+1 0 0 10 15.0
RCC det10 0 0 1000 0 0 10 15.0
RCC det20 0 0 2000 0 0 10 15.0
RCC det30 0 0 3000 0 0 10 15.0
END
* Black hole
REGION BLKBODY 5
	+world -around
* Void around
REGION VOID 5
	+around -(+horn_cyl -pl_up +pl_dow1) -det0 -det10 -det20 -det30  
	alpha=0
REGION TARGET 5
	+target
REGION HORN 5
	+horn_cyl -pl_up +pl_dow1 -(+trg_cyl -pl_up +pl_dow0) 
REGION TBOX 5
	+trg_cyl -target -pl_up +pl_dow0 
REGION DET0 5
	+det0 
REGION DET10 5
	+det10
REGION DET20 5
	+det20
REGION DET30 5
	+det30
	@select=1
END
GEOEND
!LOW-MAT CARBON GRAPHITE 6. -3. 296.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!MATERIAL AIR,,, 0.001225
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
!MATERIAL AIR2,,, 0.001225
MAT-PROP USERDIRE 1.,,, BLCKHOLE @LASTMAT
!COMPOUND AIR -0.78 NITROGEN -0.21 OXYGEN -0.01 ARGON
!COMPOUND AIR2 -0.78 NITROGEN -0.21 OXYGEN -0.01 ARGON
!MATERIAL GRAPHITE 6.,, 1.78
!STERNHEI GRAPHITE 3.155 0.048 2.5387 0.20762 2.9532 0.14
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , VACUUM VOID
ASSIGNMA , TITANIUM TARGET
ASSIGNMA , VACUUM TBOX
ASSIGNMA , HELIUM HORN
ASSIGNMA , VACUUM DET0
ASSIGNMA , VACUUM DET10
ASSIGNMA , VACUUM DET20
ASSIGNMA , VACUUM DET30
USRBIN Beampart 10. BEAMPART -21 100. 50. 1000.0 -100. -50. -10. 200. 200. 100.
USRBIN Pions0 10. PION+ -80 30. 30. 100.0 -30. -30. 80. 200. 200. 20.
USRBIN Pions10 10. PION+ -81 30. 30. 1020.0 -30. -30. 1000. 200. 200. 20.
USRBIN Pions30 10. PION+ -82 30. 30. 3020.0 -30. -30. 3000. 200. 200. 20.
USRBIN Muons0 10. MUON+ -90 30. 30. 100.0 -30. -30. 80. 200. 200. 20.
USRBIN Muons10 10. MUON+ -91 30. 30. 1020.0 -30. -30. 1000. 200. 200. 20.
USRBIN Muons30 10. MUON+ -92 30. 30. 3020.0 -30. -30. 3000. 200. 200. 20.
USRYIELD Yield 202 -113 -22 -1 -2
USRTRACK PiDET0,, PION+ -23 DET0,, 100 2 0.001
USRTRACK PiDET10,, PION+ -24 DET10,, 100 2 0.001
USRTRACK PiDET20,, PION+ -23 DET20,, 100 2 0.001
USRTRACK PiDET30,, PION+ -25 DET30,, 100 2 0.001
USRTRACK muDET0,, MUON+ -23 DET0,, 100 2 0.001
USRTRACK muDET10,, MUON+ -23 DET10,, 100 2 0.001
USRTRACK muDET20,, MUON+ -23 DET20,, 100 2 0.001
USRTRACK muDET30,, MUON+ -23 DET30,, 100 2 0.001
!AUXSCORE , USRYIELD -20808200,, NA61Be NA61Be
OPEN UNKNOWN 95.
	target_pprod.dat
!OPEN UNKNOWN 96.
	befdeg.dat
!OPEN UNKNOWN 97.
	na61exp_air.dat
!OPEN UNKNOWN 98
	BEFTAX_air.dat
RANDOMIZ
START , 1000000.,,,, 0.0
STOP
EndInput

Submit: Local
Page: Input
plotengine: Gnuplot
Compile: ESS.exe
	source: ['usrmed_fprod.f', 'usrini.f']
End

