TITLE
Simul for Ilias
GLOBAL                                         1.0       1.0
#define trg_len 78
#define trg_rad 1.5
#define horn_len 100
#define horn_rad 100
DEFAULTS                                                              NEW-DEFA
*2 GeV/c
BEAM             2.0                             0         0          PROTON
*# --- initialisation parameters: 1) if =1 assume perfect focusing
USRICALL           1
BEAMPOS          0.0       0.0        0.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           3.                                                  EVAPORAT
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           1.                                                  COALESCE
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           2.                                                  EM-DISSO
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           1.                                                  IONBRPAI
*IONTRANS    HEAVYION
EMF                                                                   EMF-OFF
*EMFCUT          1E-2      1E-2                      @LASTREG
*EMFCUT          1E-5      1E-5            BERYLLIU  BERYLLIU        1.PROD-CUT
*BIASING           1.                 1.0    T2HEAD                    PRINT
*BIASING          0.0                 5.0  T2INSHLD                    PRINT
*BIASING           1.                10.0    T2COLL                    PRINT
*BIASING           1.                10.0  AIRBEFB3                    PRINT
*BIASING           1.               100.0    B3TVac                    PRINT
*BIASING           1.               100.0  AIRBEFB2                    PRINT
*BIASING           1.               100.0  B2B3Spec                    PRINT
*BIASING           1.               100.0   AIRBEFD                    PRINT
*BIASING           1.               100.0      DEGR                    PRINT
*BIASING           1.               100.0  AIRAFTER                    PRINT
*BIASING           1.               100.0   NA61exp                    PRINT
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
GEOBEGIN                                                              COMBNAME
    0    0          
#if 0
* Black body
SPH world      0.0 0.0 0.0 1200.0
#endif
#if 0
* Void sphere
SPH around     0.0 0.0 0.0 1000.0
#endif
RPP world      -300. 300. -300 300. -500. 40000.
RPP around     -150 150. -150. 150 -300. 10000
RCC target     0.0 0.0 0 0.0 0.0 $trg_len $trg_rad
!@what.3=trg_rad+2
ZCC trg_cyl    0.0 0.0 3.5
ZCC horn_cyl   0.0 0.0 $horn_rad
XYP pl_up      -2
!@what.1=trg_len+2
XYP pl_dow0    80
XYP pl_dow1    $horn_len
!@what.3=horn_len+1
RCC det0       0 0 101 0 0 10 15.0
RCC det10      0 0 1000 0 0 10 15.0
RCC det20      0 0 2000 0 0 10 15.0
RCC det30      0 0 3000 0 0 10 15.0
END
* Black hole
BLKBODY      5 +world -around
* Void around
VOID         5 +around -(+horn_cyl -pl_up +pl_dow1) -det0 -det10 -det20 -det30
TARGET       5 +target
HORN         5 +horn_cyl -pl_up +pl_dow1 -(+trg_cyl -pl_up +pl_dow0)
TBOX         5 +trg_cyl -target -pl_up +pl_dow0
DET0         5 +det0
DET10        5 +det10
DET20        5 +det20
DET30        5 +det30
END
GEOEND
*LOW-MAT     GRAPHITE        6.       -3.      296.                    CARBON
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*MATERIAL                        0.001225                              AIR
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*MATERIAL                        0.001225                              AIR2
MAT-PROP          1.                      BLCKHOLE  @LASTMAT          USERDIRE
*COMPOUND       -0.78  NITROGEN     -0.21    OXYGEN     -0.01     ARGONAIR
*COMPOUND       -0.78  NITROGEN     -0.21    OXYGEN     -0.01     ARGONAIR2
*MATERIAL          6.                1.78                              GRAPHITE
*STERNHEI       3.155     0.048    2.5387   0.20762    2.9532      0.14GRAPHITE
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
ASSIGNMA    BLCKHOLE   BLKBODY
ASSIGNMA      VACUUM      VOID
ASSIGNMA    TITANIUM    TARGET
ASSIGNMA      VACUUM      TBOX
ASSIGNMA      HELIUM      HORN
ASSIGNMA      VACUUM      DET0
ASSIGNMA      VACUUM     DET10
ASSIGNMA      VACUUM     DET20
ASSIGNMA      VACUUM     DET30
USRBIN           10.  BEAMPART       -21      100.       50.    1000.0Beampart
USRBIN         -100.      -50.      -10.      200.      200.      100. &
USRBIN           10.     PION+       -80       30.       30.     100.0Pions0
USRBIN          -30.      -30.       80.      200.      200.       20. &
USRBIN           10.     PION+       -81       30.       30.    1020.0Pions10
USRBIN          -30.      -30.     1000.      200.      200.       20. &
USRBIN           10.     PION+       -82       30.       30.    3020.0Pions30
USRBIN          -30.      -30.     3000.      200.      200.       20. &
USRBIN           10.     MUON+       -90       30.       30.     100.0Muons0
USRBIN          -30.      -30.       80.      200.      200.       20. &
USRBIN           10.     MUON+       -91       30.       30.    1020.0Muons10
USRBIN          -30.      -30.     1000.      200.      200.       20. &
USRBIN           10.     MUON+       -92       30.       30.    3020.0Muons30
USRBIN          -30.      -30.     3000.      200.      200.       20. &
USRYIELD         202      -113       -22        -1        -2          Yield
USRTRACK                 PION+       -23      DET0                 100PiDET0
USRTRACK           2     0.001                                         &
USRTRACK                 PION+       -24     DET10                 100PiDET10
USRTRACK           2     0.001                                         &
USRTRACK                 PION+       -23     DET20                 100PiDET20
USRTRACK           2     0.001                                         &
USRTRACK                 PION+       -25     DET30                 100PiDET30
USRTRACK           2     0.001                                         &
USRTRACK                 MUON+       -23      DET0                 100muDET0
USRTRACK           2     0.001                                         &
USRTRACK                 MUON+       -23     DET10                 100muDET10
USRTRACK           2     0.001                                         &
USRTRACK                 MUON+       -23     DET20                 100muDET20
USRTRACK           2     0.001                                         &
USRTRACK                 MUON+       -23     DET30                 100muDET30
USRTRACK           2     0.001                                         &
*AUXSCORE    USRYIELD -20808200              NA61Be    NA61Be
OPEN             95.                                                  UNKNOWN
target_pprod.dat
#if 0
OPEN             96.                                                  UNKNOWN
befdeg.dat
#endif
#if 0
OPEN             97.                                                  UNKNOWN
na61exp_air.dat
#endif
#if 0
OPEN              98                                                  UNKNOWN
BEFTAX_air.dat
#endif
RANDOMIZ
START       1000000.                                     0.0
STOP
