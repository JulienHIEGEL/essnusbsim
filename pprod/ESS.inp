TITLE
Particle production at ESSnuSB target
GLOBAL                                         1.0       1.0
#define trg_len 78
#define trg_rad 1.5
!#define horn_len 100
!#define horn_rad 100
#define horn 1000
#define tline 3000
#define pstraight 8000
#define neardet 13000
DEFAULTS                                                              NEW-DEFA
*2.5 GeV/c
BEAM             2.5                             0         0          PROTON
*# --- initialisation parameters: 1) if =1 assume perfect focusing
USRICALL           1
BEAMPOS          0.0       0.0        0.
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           3.                                                  EVAPORAT
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           1.                                                  COALESCE
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           2.                                                  EM-DISSO
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*PHYSICS           1.                                                  IONBRPAI
*IONTRANS    HEAVYION
EMF                                                                   EMF-OFF
*EMFCUT          1E-2      1E-2                      @LASTREG
*EMFCUT          1E-5      1E-5            BERYLLIU  BERYLLIU        1.PROD-CUT
*BIASING           1.                 1.0    T2HEAD                    PRINT
*BIASING          0.0                 5.0  T2INSHLD                    PRINT
*BIASING           1.                10.0    T2COLL                    PRINT
*BIASING           1.                10.0  AIRBEFB3                    PRINT
*BIASING           1.               100.0    B3TVac                    PRINT
*BIASING           1.               100.0  AIRBEFB2                    PRINT
*BIASING           1.               100.0  B2B3Spec                    PRINT
*BIASING           1.               100.0   AIRBEFD                    PRINT
*BIASING           1.               100.0      DEGR                    PRINT
*BIASING           1.               100.0  AIRAFTER                    PRINT
*BIASING           1.               100.0   NA61exp                    PRINT
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
GEOBEGIN                                                              COMBNAME
    0    0          
* Black body
SPH world      0.0 0.0 0.0 100000.0
* Void sphere
SPH around     0.0 0.0 0.0 90000.0
#if 0
RPP world      -300. 300. -300 300. -500. 40000.
#endif
#if 0
RPP around     -150 150. -150. 150 -300. 10000
#endif
RCC target     0.0 0.0 0 0.0 0.0 $trg_len $trg_rad
!@what.6=trg_len+2
!@what.7=trg_rad+1
RCC trg_cyl    0.0 0.0 -1 0 0 80 2.5
!@what.6=trg_len+4
!@what.7=trg_rad+2
RCC trg_cylo   0.0 0.0 -2 0 0 82 3.5
#if 0
ZCC horn_cyl   0.0 0.0 $horn_rad
#endif
#if 0
XYP pl_up      -2
#endif
#if 0
!@what.1=trg_len+2
XYP pl_dow0    80
#endif
#if 0
XYP pl_dow1    $horn_len
#endif
!@what.5=trg_len+5
!@what.6=trg_len+6
RPP trg_end    -30 30 -30 30 83 84
!@what.6=horn+1
RPP horn_end   -30 30 -30 30 $horn 1001
!@what.6=tline+1
RPP tline      -30 30 -30 30 $tline 3001
!@what.6=pstraight+1
RPP prods      -30 30 -30 30 $pstraight 8001
!@what.6=neardet+1
RPP neardet    -500 500 -500 500 $neardet 13001
END
* Black hole
BLKBODY      5 +world -around
* Void around
VOID         5 +around -trg_cylo -trg_end -horn_end -tline -prods -neardet | +trg_cyl -target
TARGET       5 +target
#if 0
HORN         5 +horn_cyl -pl_up +pl_dow1 -(+trg_cyl -pl_up +pl_dow0)
#endif
TBOX         5 +trg_cylo -trg_cyl
TRGEND       5 +trg_end
HORNEND      5 +horn_end
TLINEEND     5 +tline
PRODS        5 +prods
NEARDET      5 +neardet
END
GEOEND
*LOW-MAT     GRAPHITE        6.       -3.      296.                    CARBON
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*MATERIAL                        0.001225                              AIR
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*MATERIAL                        0.001225                              AIR2
MAT-PROP          1.                      BLCKHOLE  @LASTMAT          USERDIRE
*COMPOUND       -0.78  NITROGEN     -0.21    OXYGEN     -0.01     ARGONAIR
*COMPOUND       -0.78  NITROGEN     -0.21    OXYGEN     -0.01     ARGONAIR2
*MATERIAL          6.                1.78                              GRAPHITE
*STERNHEI       3.155     0.048    2.5387   0.20762    2.9532      0.14GRAPHITE
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
ASSIGNMA    BLCKHOLE   BLKBODY
ASSIGNMA      VACUUM      VOID
ASSIGNMA    TITANIUM    TARGET
ASSIGNMA      VACUUM      TBOX
ASSIGNMA      VACUUM    TRGEND
ASSIGNMA      VACUUM   HORNEND
ASSIGNMA      VACUUM  TLINEEND
ASSIGNMA      VACUUM     PRODS
ASSIGNMA      VACUUM   NEARDET
!@what.6=horn+1
*USRBIN           10.  BEAMPART       -21       30.       30.      1001Beampart
*USRBIN          -30.      -30.     $horn       60.       60.         1 &
!@what.6=trg_len+1
*USRBIN           10.     PION+       -80       30.       30.        79Pions-Trg
*USRBIN          -30.      -30.  $trg_len      200.      200.        1. &
!@what.6=horn+1
*USRBIN           10.     PION+       -81       30.       30.      1001Pions-Horn
*USRBIN          -30.      -30.     $horn      200.      200.        1. &
!@what.6=tline+1
*USRBIN           10.     PION+       -82       30.       30.      3001Pions-Tline
*USRBIN          -30.      -30.    $tline      200.      200.        1. &
!@what.6=pstraight+1
*USRBIN           10.     PION+       -83       30.       30.      8001Pions-Prods
*USRBIN          -30.      -30.$pstraight      200.      200.        1. &
!@what.6=trg_len+1
*USRBIN           10.     MUON+       -90       30.       30.        79Muons-Trg
*USRBIN          -30.      -30.  $trg_len      200.      200.         1 &
!@what.6=horn+1
*USRBIN           10.     MUON+       -91       30.       30.      1001Muons-Horn
*USRBIN          -30.      -30.     $horn      200.      200.         1 &
!@what.6=tline+1
*USRBIN           10.     MUON+       -92       30.       30.      3001Muons-Tline
*USRBIN          -30.      -30.    $tline      200.      200.         1 &
!@what.6=pstraight+1
*USRBIN            10     MUON+       -92       30.       30.      8001Muons-Prods
*USRBIN          -30.      -30.$pstraight      200.      200.         1 &
*USRYIELD         202  -UNKNOWN       -22        -1        -2          Yield
*USRTRACK                 PION+       -23   HORNEND                 100PiDET0
*USRTRACK           2     0.001                                         &
*USRTRACK                 PION+       -24  TLINEEND                 100PiDET10
*USRTRACK           2     0.001                                         &
*USRTRACK                 PION+       -23     PRODS                 100PiDET20
*USRTRACK           2     0.001                                         &
*USRTRACK                 PION+       -25   NEARDET                 100PiDET30
*USRTRACK           2     0.001                                         &
*USRTRACK                 MUON+       -23   HORNEND                 100muDET0
*USRTRACK           2     0.001                                         &
*USRTRACK                 MUON+       -23  TLINEEND                 100muDET10
*USRTRACK           2     0.001                                         &
*USRTRACK                 MUON+       -23     PRODS                 100muDET20
*USRTRACK           2     0.001                                         &
*USRTRACK                 MUON+       -23   NEARDET                 100muDET30
*USRTRACK           2     0.001                                         &
*AUXSCORE    USRYIELD -20808200              NA61Be    NA61Be
USRBDX            99  BEAMPART       -49      VOID    TRGEND       900ProtTarg
USRBDX           3.0     0.001       100                               &
USRBDX            99     PION+       -50      VOID    TRGEND       900PITarget
USRBDX           1.5     0.001       100                               &
USRBDX            99     PION+       -51      VOID   HORNEND       900PIHorn
USRBDX           1.5     0.001       100                               &
USRBDX            99     PION+       -52      VOID  TLINEEND       900PITline
USRBDX           1.5     0.001       100                               &
USRBDX            99     PION+       -53      VOID     PRODS       900PIPstr
USRBDX           1.5     0.001       100                               &
USRBDX            99     MUON+       -60      VOID    TRGEND       900MuTarg
USRBDX           1.5     0.001       100                               &
USRBDX            99     MUON+       -61      VOID   HORNEND       900MuHorn
USRBDX           1.5     0.001       100                               &
USRBDX            99     MUON+       -62      VOID  TLINEEND       900MuTline
USRBDX           1.5     0.001       100                               &
USRBDX            99     MUON+       -63      VOID     PRODS       900MuPstr
USRBDX           1.5     0.001       100                               &
OPEN             95.                                                  UNKNOWN
target_pprod.dat
#if 0
OPEN             96.                                                  UNKNOWN
befdeg.dat
#endif
#if 0
OPEN             97.                                                  UNKNOWN
na61exp_air.dat
#endif
#if 0
OPEN              98                                                  UNKNOWN
BEFTAX_air.dat
#endif
RANDOMIZ
START         20000.                                     0.0
STOP
