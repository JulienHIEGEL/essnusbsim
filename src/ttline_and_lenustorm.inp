TITLE
ESS-Transfer Line and LEnuStorm Simulation
* General Parameters
*   beamrad : nominal beam radius to calculate apertures
#define pbeam 0.7
#define ptline 0.7
#define beam_rad 20
#define clight 29979245800
*
* Facility
*    target chamber : 3m x 5m
*    shielding : 4m width
#define tcc_len 300
#define tcc_width 350
#define tcc_shield 400
!@what.1=tcc_width+tcc_shield
#define tcc_o 750
*
* Decay pipe
*	length = 80m
*	radius = 1m
*	shielding = 4m
#define tdec_len 8000
#define tdec_rad 250
#define tdec_shield 400
!@what.1=tdec_rad+tdec_shield
#define tdec_wid 650
*
* Beam dump
*	length 	= 5m
*	width 	= 3m
#define bdump_len 500
#define bdump_wid 300
*
* ESSnuSB near detector
*	distance (from target) = 250m
#define ndet_dis 25000
#define ndet_wid 500
*
* TTline to leNuSTORM
* -------------------
*
* Magnet prototypes
#define d1_len 221
!@what.1=d1_len+0.1
#define d1_vlen 221.1
#define d1_k0 0.428
!@what.1=d1_k0*d1_len/100
#define d1_arad 0.94588
!@what.1=d1_arad*180/pi
#define d1_adeg 54.1949319258343
!@what.1=d1_arad*ptline/clight/d1_len*1.0e13
#define d1_b0 0.999358029213663
!@what.1=d1_len*tan(d1_arad/2)
#define d1_defl 113.0790801578376
!@what.1=d1_len - d1_defl/tan(d1_arad)
#define d1_pivot 139.429589070911
!@what.1=d1_defl + 2*beam_rad
#define d1_apx 153.0790801578376
!@what.1=2*beam_rad
#define d1_apy 40
!@what.1=d1_apx+60
#define d1_xsiz 213.0790801578376
!@what.1=d1_apy+100
#define d1_ysiz 140
#define q1_len 80
#define q1_ap 44
#define q1_fe 40
!@what.1=q1_ap+q1_fe
#define q1_rad 84
#define drift0 200
#define drift1 50
#define drift2 20
#define drift3 35.3
#define drift4 35.3
#define drift5 35.3
#define drift6 35.3
#define drift7 20
#define drift8 50
!@what.1=drift0
#define s_d1 200
!@what.1=d1_pivot+drift1
#define s_q1 189.429589070911
!@what.1=s_q1+q1_len+drift2
#define s_q2 289.429589070911
!@what.1=s_q2+q1_len+drift3
#define s_q3 404.729589070911
!@what.1=s_q3+q1_len+drift4
#define s_q4 520.029589070911
!@what.1=s_q4+q1_len+drift5
#define s_q5 635.329589070911
!@what.1=s_q5+q1_len+drift6
#define s_q6 750.6295890709109
!@what.1=s_q6+q1_len+drift7
#define s_q7 850.6295890709109
!@what.1=s_q7+q1_len+drift8
#define s_d2 980.6295890709109
*
* LEnuSTORM
*	nstorm_ss_len	= 75m
*	nstorm_tun_wid = 4m
#define nstorm_ss_len 7500
#define nstorm_tun_wid 400
*
* Target & Horn
#define thbox_rad 100
#define thbox_zmax 100
#define thbox_zmin -10
*
* Target
#define tgt_rad 1.5
#define tgt_len 78
*
*Set the defaults for precision simulations
DEFAULTS                                                              PRECISIO
FREE
*
*Define the beam characteristics
BEAM      , $pbeam, 0, 0, 2.5, 2.5,  ,MUON+
*Define the beam position
BEAMPOS   , 0, 0, 0
*
* --- Beam line element lattices -----
*
* #include ttline_elements_lattice.inp
* #include lenustorm_elements_lattice.inp
*
USRBIN    , 10, BEAMPART, -21, 100, 100, 800, Beampart
USRBIN    , -300, -100, 300, 400, 400, 500,  &
USRBIN    , 10, BEAMPART, -22, 100, 10, 1300, Beampar1
USRBIN    , -1000, -10, 0, 400, 20, 500,  &
GEOBEGIN   ,  ,  ,  ,  ,  ,  , COMBNAME
0,0,
SPH blkbody    0 0 0 100000
SPH void       0 0 0 90000
* RPP tcc_o      -$tcc_o $tcc_o -$tcc_o $tcc_o -100 $tcc_len
* RPP tcc        -$tcc_width $tcc_width -$tcc_width $tcc_width -50 301
* RPP tdec_o     -$tdec_wid $tdec_wid -$tdec_wid $tdec_wid 299 8001
* RPP tdec       -$tdec_rad $tdec_rad -$tdec_rad $tdec_rad 298 7502
*Target & Horn box
!@what.5=tcc_len-2
!@what.6=tdec_len-bdump_len+2
RCC thbox      0 0.0 $thbox_zmin 0 298 7502 $thbox_rad
RCC target     0 0.0 0 0 0 $tgt_len $tgt_rad
*
* --- Models and tunnels bodies ----
#include models_and_tunnels_bodies.inp
*
*---- Magnet models bodies -----
*
#include lenustorm_models_bodies.inp
*
* ---- Beam elements (replicas) ----
*
#include ttline_elements_replicas.inp
#include lenustorm_elements_replicas.inp
*
END
BLKBODY      5 +blkbody -void
VOID         5 +void -tcc_o -tdec_o -parko -tltuno -rgtnlo
SHIELD       5 (+tcc_o -tcc)
               | +tdec_o -tcc_o -tcc -tdec -tltun
               | +rgtnlo -rgtnli -tltun
               | +tltuno -tltun -rgtnlo -tdec_o -tcc_o
! VOID         5 +void -thbox
THBOX        5 +thbox -target
TARGET       5 +target
*
* --- Models and tunnels regions ----
#include models_and_tunnels_regions.inp
*
* --- Magnet models regions -----
*
#include lenustorm_models_regions.inp
*
* --- Beam line element regions -----
*
#include ttline_elements_regions.inp
#include lenustorm_elements_regions.inp
*
END
GEOEND
#if 0
Black     , -, size,  , , , ,body
#endif
*..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
ASSIGNMA  , BLCKHOLE, BLKBODY
ASSIGNMA  , VACUUM, VOID
*ASSIGNMA  , BLCKHOLE, PARKBB
*ASSIGNMA  , VACUUM, PARK
*ASSIGNMA  , IRON, SHIELD
*ASSIGNMA  , HELIUM, TCC_CAV
ASSIGNMA  , VACUUM, THBOX
ASSIGNMA  , TUNGSTEN, TARGET
*ASSIGNMA  , HELIUM, TTMBEnv, BEnv, 3
*ASSIGNMA  , IRON, TTMBFe, BFe, 3
*ASSIGNMA  , VACUUM, TTMBVac, BVac, 3, 1
*ASSIGNMA  , IRON, BDUMP, , 3
*ASSIGNMA  , CARBON, BDUMPC, , 3
*MGNCREAT  , 2,  , , , , ,D1
*MGNFIELD  , $d1_b0, , 2, BEND0,  , ,D1
*MGNFIELD  , -$d1_b0, , 2, BEND1,  , ,D1
*
* --- Beam line element ROT-DEFI from the replicas to the models  -----
*
*! - ROTDEFI for tline punchthrough tunnel
ROT-DEFI  , 200, , 29.5323277145495,  , , ,tltnl
ROT-DEFI  , 0, , , 0, 0.0, 400.0, tltnl
*! - ROTDEFI for LEnuSTORM tunnel
ROT-DEFI  , 0, , , -1826.0451267159, 0.0, 1521.942926625236, rgtnl
ROT-DEFI  , 200, , -2.89124868466982,  , , ,rgtnl
*
* #include ttline_elements_rotdefi.inp
* #include lenustorm_elements_rotdefi.inp
*
*Set the random number seed
RANDOMIZ  , 1.0
*Set the number of primary histories to be simulated in the run
START     , 1000
STOP
