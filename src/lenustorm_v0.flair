md5: c748203097ed96379a22568c3dbb4e9d
Input:
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7...
*
TITLE
	ESSnuSB Beam to LEnuSTORM
*-----
*GEOMETRY parameters
*-----
* Facility
* --------
* Target chamber
* 	length = -1m to +3m = 4ms
* 	width  = 2.5m
* 	shielding width = 4m
#define tcc_len 300
#define tcc_width 250
#define tcc_shield 400
#define tcc_o =tcc_width+tcc_shield
*
* Decay pipe
*	length = 80m
*	radius = 1m
*	shielding = 4m
#define tdec_len 8000
#define tdec_rad 100
#define tdec_shield 400
#define tdec_wid =tdec_rad+tdec_shield
*
* Beam dump
*	length 	= 5m
*	width 	= 3m
#define bdump_len 500
#define bdump_wid 300
*
* ESSnuSB near detector
*	distance (from target) = 250m
#define ndet_dis 25000
#define ndet_wid 500
*
* TTline to leNuSTORM
* -------------------
*
* Magnet prototypes
#define d1_len 221
#define d1_k0 0.428
#define d1_arad =d1_k0*d1_len/100
#define d1_adeg =d1_arad*180/pi
#define d1_apx =0.5*sin(d1_arad)*d1_len
#define d1_apy =40
#define d1_xsiz =d1_apx*1.20
#define d1_ysiz =d1_apy*1.20
#define d1_arc =d1_len/2/cos(d1_arad/2)**2
#define q1_len 80
#define q1_ap 40
#define q1_fe 20
#define q1_rad =q1_ap+q1_fe + mqa_fe
#define drift1 400
#define drift2 20
#define drift3 20
#define drift4 35.3
#define drift5 35.3
#define drift6 35.3
#define drift7 35.3
#define drift8 20
#define drift9 20
*
* LEnuSTORM
*	nstorm_ss_len	= 75m
*	nstorm_tun_wid = 4m
#define nstorm_ss_len 7500
#define nstorm_tun_wid 400
*
* Target & Horn
#define thbox_rad 100
#define thbox_zmax 100
#define thbox_zmin -10
*
* Target
#define tgt_rad 1.5
#define tgt_len 78
*
* Horn
#define hon_zmin 6.1
#define h_thick0 1.0
#define h_thick 0.3
#define h_z1 64.98
#define h_z2 46.8
#define h_z3 60.3
#define h_z4 47.5
#define h_z5 1.08
#define h_z6 5.44
#define h_z7 5.44
#define h_z8 5.44
#define h_z9 5.44
#define h_z10 5.74
#define h_ltot '=h_z1+h_z2+h_z3+h_z4+h_z5+h_z6+h_z7+h_z8+h_z9+h_z10 '
#define h_rin1 3.0
#define h_rin2 22.1
#define h_rin3 3.54
#define h_rin4 5.24
#define h_rin5 8.37
#define h_rin6 13.86
#define h_rin7 30.5
#define h_rout1 57.7
#define h_rout2 57.15
#define h_rout3 55.43
#define h_rout4 52.26
#define h_rout5 46.82
#define h_rout6 30.5
#define h_romax =57.7+h_thick0
#define h_rimin =h_rin1
*
* --- obsolete defines
*
!#define SampleDose
!#define x1 0
!#define y1 0
!#define z00 6.1
!#define L10 64.98
!#define z0 7.1
!#define L11 63.98
!#define z1 71.08
!#define L2 46.8
!#define z2 117.88
!#define L3 60.3
!#define z3 178.18
!#define L4 47.5
!#define z4 225.68
!#define L5 1.08
!#define z5 226.76
!#define dz 5.44
!#define z6 232.2
!#define z7 237.64
!#define z8 243.08
!#define z9 248.52
!#define dzx 5.74
!#define R0x 58.7
!#define R00 58
!#define R01 57.46
!#define R02 55.76
!#define R03 52.63
!#define R04 47.32
!#define R05 30.5
!#define h00 3
!#define h01 22.1
!#define R11 3.54
!#define R12 5.24
!#define R13 8.37
!#define R14 13.68
!#define R15 30.5
!#define R2x 57.7
!#define R20 57.7
!#define R21 57.15
!#define R22 55.43
!#define R23 52.26
!#define R24 46.82
!#define R25 30.5
!#define h10 3.3
!#define h11 22.4
!#define R31 3.85
!#define R32 5.57
!#define R33 8.74
!#define R34 14.18
!#define R35 30.5
!#define Ltot 254.26
!#define Lbox 305.112
!#define Rbox 70.44
!#define zb -25.426
!#define hdtm -200
!#define hezm -200
!#define hezp 300
!#define hdtzm 300
!#define hdtzp 2800
!#define dx -200
!#define dy -200
* ---------
MULSOPT
DEFAULTS NEW-DEFA
*Beam definition
* ---------------
*  Gaussian beam, 2.5GeV, (sigma_x, sigma_y) = (0.05cm, 0.1cm)
BEAM PROTON -2.5 0.0 0.0 -0.05 -0.1 1.0
BEAMPOS , 0 0 0 0.0 0.0
*
* Geometry
* --------
GEOBEGIN COMBNAME
* Black body - size 100m
SPH blkbody 0 0 0 100000
SPH void 0 0 0 90000
RPP tcc_o -$tcc_o $tcc_o -$tcc_o $tcc_o -100 $tcc_len
RPP tcc -$tcc_width $tcc_width -$tcc_width $tcc_width -50 =tcc_len+1
RPP tdec_o -$tdec_wid $tdec_wid -$tdec_wid $tdec_wid =tcc_len-1 =tdec_len+1
RCC tdec 0 0 =tcc_len-2 0 0 =tdec_len-bdump_len+2 $tdec_rad
*Target & Horn box
RCC thbox 0 0 $thbox_zmin 0 0 $thbox_zmax $thbox_rad
RCC target 0 0 0 0 0 $tgt_len $tgt_rad
!ZCC horn_O0 0 0 =h_rout1+h_thick0
!ZCC horn_O1 0 0 =h_rout1
!XYP PyZhuP1 =shift_horn
!XYP PyZhuP2 =shift_horn+h_thick0
!XYP PyZhoP =shift_horn+h_thick0+h_z1+h_z2+h_z3+h_z4+h_z5
!ZCC horn_I0 0 0 =h_rin1+h_thick
!ZCC horn_I1 0 0 =h_rin1
!XYP PyZhiP1 =shift_horn+h_thick+h_z1
!$end_translat
!TRC h00 $x1 0.0 $z00 0.0 0.0 $L10 $R0x $R0x
!TRC h01 $x1 0.0 $z1 0.0 0.0 $L2 $R0x $R0x
!TRC h02 $x1 0.0 $z2 0.0 0.0 $L3 $R0x $R0x
!TRC h03 $x1 0.0 $z3 0.0 0.0 $L4 $R0x $R0x
!TRC h04 $x1 0.0 $z4 0.0 0.0 $L5 $R0x $R00
!TRC h05 $x1 0.0 $z5 0.0 0.0 $dz $R00 $R01
!TRC h06 $x1 0.0 $z6 0.0 0.0 $dz $R01 $R02
!TRC h07 $x1 0.0 $z7 0.0 0.0 $dz $R02 $R03
!TRC h08 $x1 0.0 $z8 0.0 0.0 $dz $R03 $R04
!TRC h09 $x1 0.0 $z9 0.0 0.0 $dzx $R04 $R05
!TRC h10 $x1 0.0 $z00 0.0 0.0 $L10 $h00 $h00
!TRC h11 $x1 0.0 $z1 0.0 0.0 $L2 $h00 $h01
!TRC h12 $x1 0.0 $z2 0.0 0.0 $L3 $h01 $h01
!TRC h13 $x1 0.0 $z3 0.0 0.0 $L4 $h01 $h00
!TRC h14 $x1 0.0 $z4 0.0 0.0 $L5 $h00 $h00
!TRC h15 $x1 0.0 $z5 0.0 0.0 $dz $h00 $R11
!TRC h16 $x1 0.0 $z6 0.0 0.0 $dz $R11 $R12
!TRC h17 $x1 0.0 $z7 0.0 0.0 $dz $R12 $R13
!TRC h18 $x1 0.0 $z8 0.0 0.0 $dz $R13 $R14
!TRC h19 $x1 $y1 $z9 0.0 0.0 $dzx $R14 $R15
!TRC h20 $x1 $y1 $z0 0.0 0.0 $L11 $R20 $R20
!TRC h21 $x1 $y1 $z1 0.0 0.0 $L2 $R20 $R20
!TRC h22 $x1 $y1 $z2 0.0 0.0 $L3 $R20 $R20
!TRC h23 $x1 $y1 $z3 0.0 0.0 $L4 $R20 $R20
!TRC h24 $x1 $y1 $z4 0.0 0.0 $L5 $R20 $R20
!TRC h25 $x1 $y1 $z5 0.0 0.0 $dz $R20 $R21
!TRC h26 $x1 $y1 $z6 0.0 0.0 $dz $R21 $R22
!TRC h27 $x1 $y1 $z7 0.0 0.0 $dz $R22 $R23
!TRC h28 $x1 $y1 $z8 0.0 0.0 $dz $R23 $R24
!TRC h29 $x1 $y1 $z9 0.0 0.0 $dz $R24 $R25
!TRC h30 $x1 $y1 $z0 0.0 0.0 $L11 $h10 $h10
!TRC h31 $x1 $y1 $z1 0.0 0.0 $L2 $h10 $h11
!TRC h32 $x1 $y1 $z2 0.0 0.0 $L3 $h11 $h11
!TRC h33 $x1 $y1 $z3 0.0 0.0 $L4 $h11 $h10
!TRC h34 $x1 $y1 $z4 0.0 0.0 $L5 $h10 $h10
!TRC h35 $x1 $y1 $z5 0.0 0.0 $dz $h10 $R31
!TRC h36 $x1 $y1 $z6 0.0 0.0 $dz $R31 $R32
!TRC h37 $x1 $y1 $z7 0.0 0.0 $dz $R32 $R33
!TRC h38 $x1 $y1 $z8 0.0 0.0 $dz $R33 $R34
!TRC h39 $x1 $y1 $z9 0.0 0.0 $dz $R34 $R35
!RPP dt $hdtm $hdtp $hdtm $hdtp $hdtzm $hdtzp
*---- Magnet Models -----
$start_translat -1000 0 0
*MBAH Magnet envelop (+1mm bigger) - includes coils
RPP MBHAVol =-d1_xsiz/2-0.1 =d1_xsiz/2+0.1 =-d1_ysiz/2-0.1 =d1_ysiz/2+0.1 =-0.1 \
	 =d1_len+0.1
RPP MBHAFe =-d1_xsiz/2 =d1_xsiz/2 =-d1_ysiz/2 =d1_ysiz/2 0 =d1_len
RPP MBHAVac =-d1_apx/2 =d1_apx/2 =-d1_apy/2 =d1_apy/2 -0.05 =d1_len+0.05
$end_translat
$start_translat -2000 0 0
RCC MQAVol 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
RCC MQAFe 0 0 0 0 0 =q1_len =q1_rad
RCC MQAVac 0 0 -0.05 0 0 =q1_len+0.1 =q1_ap
	@select=1
$end_translat
*
* ------------- Beam line magnets ----------------------------
*first segment elements
ROT-DEFI ttd1 0 0 0 =d1_apx/2 0 =-1000-0.1-drift1
*segment B elements (after MBHA rotation)
ROT-DEFI ttsegb 200,, =mbha_adeg
ROT-DEFI ttsegb,,,,,, =drift1+mbha_arc
ROT-DEFI segb_angl 200,, =mbha_adeg
!ROT-DEFI q1segb 100,,, 200
!ROT-DEFI q1segb 300,,, 0,, =-1000-0.1
!ROT-DEFI q1segb 200,,, 200,, =-1000-0.1
ROT-DEFI q1segb 200,, =mbha_adeg,, 0
ROT-DEFI q1segb 300,,,, 0 =drift1+mbha_arc+(mbha_arc+drift2)*cos(mbha_arad)
ROT-DEFI q1segb 100,,, =-(mbha_arc+drift2)*sin(mbha_arad) 0
$start_transform -ttmbha
*-- empty MBHA container for the lattice (replica)
RPP MBHA =-mbha_xsiz/2-0.1 =mbha_xsiz/2+0.1 =-mbha_ysiz/2-0.1 =mbha_ysiz/2+0.1 \
	 =-1000-0.1 =-1000+mbha_len+0.1
$end_transform
$start_transform ttsegb
ZCC ttex 0 0 =mqa_rad*1.5
$end_transform
YZP ttexi =-tdec_rad
YZP ttexo =-tdec_rad-tdec_shield
$start_transform q1segb
RCC MQA1 0 0 0 0 0 =mqa_len+0.2 =mqa_rad+0.1
$end_transform
!RCC MQA2 0 0 0 0 0 =mqa_len+0.2 =mqa_rad+0.1
END
* Black hole
REGION BLKBODY
	+blkbody -void
REGION VOID
	+void -tcc_o -tdec_o -MBHAVol -MQAVol  
REGION SHIELD
	+tcc_o -tcc
	| +tdec_o -tcc_o -tcc -tdec -(+ttex +ttexi)  
REGION TCC_CAV 5
	+tcc -thbox -MBHA 
	| +tdec -MBHA
	| +ttex +ttexi -ttexo -MQA1 
!REGION TDEC 5
	+tdec -tcc -MBHA 
REGION THBOX 5
	+thbox -target
REGION TARGET 5
	+target 
REGION MBHA 5
	+MBHA  
REGION MQA1 5
	+MQA1  
!REGION HBOX 5
	+thbox -target 
	-(+horn_O1 -horn_I0 -PyZhuP1 +PyZhuP2 )
	-(+horn_O0 -horn_O1 +PyZhoP -PyZhuP1  )
	-(+horn_I0 -horn_I1 -PyZhuP1  +PyZhiP1 )
!REGION TARGET 5
	+target
!REGION HORNCo 5
	+horn_O1 -horn_I0 -PyZhuP1 +PyZhuP2 
	| +horn_O0 -horn_O1 +PyZhoP -PyZhuP1 
	| +horn_I0 -horn_I1 -PyZhuP1  +PyZhiP1 
!REGION DECTUBE 5
	+tdec 
!REGION BOX1 5
	+box1
	-h00 -h01 -h02 -h03 -h04 -h05 -h06 -h07 -h08 -h09-target
!REGION RHALUP 5
	+h00-h20 -h30 -h10-target |+h30 -h10-target
	|+h01-h21 -h31 -h11-target |+h31 -h11-target
	|+h02-h22 -h32 -h12-target |+h32 -h12-target
	|+h03-h23 -h33 -h13-target |+h33 -h13-target
	|+h04-h24 -h34 -h14-target |+h34 -h14-target
	|+h05-h25 -h35 -h15-target |+h35 -h15-target
	|+h06-h26 -h36 -h16-target |+h36 -h16-target
	|+h07-h27 -h37 -h17-target |+h37 -h17-target
	|+h08-h28 -h38 -h18-target |+h38 -h18-target
	|+h09-h29 -h39 -h19-target |+h39 -h19-target
!REGION RHBF 5
	+h20-h30-target
	|+h21-h31-target
	|+h22-h32-target
	|+h23-h33-target
	|+h24-h34-target
	|+h25-h35-target
	|+h26-h36-target
	|+h27-h37-target
	|+h28-h38-target
	|+h29-h39-target
!REGION RHALDOWN 5
	+h30 -h20-target
	|+h31 -h21-target
	|+h32 -h22-target
	|+h33 -h23-target
	|+h34 -h24-target
	|+h35 -h25-target
	|+h36 -h26-target
	|+h37 -h27-target
	|+h38 -h28-target
	|+h39 -h29-target
!REGION RHIN 5
	+h10-target   |+h11-target   |+h12-target   |+h13-target  |+h14-target
	|+h15-target  |+h16 -target |+h17 -target |+h18 -target  |+h19-target
!REGION DT 5
	+dt
REGION MBHEnv
	+MBHAVol -MBHAFe -MBHAVac 
REGION MBHFe
	+MBHAFe -MBHAVac 
REGION MBHVac
	+MBHAVac 
REGION MQAEnv
	+MQAVol -MQAFe -MQAVac 
REGION MQAFe
	+MQAFe -MQAVac 
REGION MQAVac
	+MQAVac  
LATTICE ttmbha MBHA,,, MBHA
LATTICE q1segb MQA1,,, MQA1
GEOEND
*
* Material definitions
* --------------------
MATERIAL POTASSIU 19. 39.0983 0.862
MATERIAL CHROMIUM 24. 51.9961 7.18
MATERIAL MANGANES 25. 54.938049 7.21
MATERIAL PHOSPHO 15. 30.973761 1.82
MATERIAL SULFUR 16. 32.066 2.07
* Steel316LN
* Stainless steel AISI316LN
MATERIAL SS316LN,,, 7.8
COMPOUND SS316LN -0.67145 IRON -0.185 CHROMIUM -0.1125 NICKEL -0.02 MANGANES -0.01 \
	 SILICON -0.00045 PHOSPHO -0.0003 SULFUR -0.0003 CARBON
*
* Concrete portland
* -----------------
MATERIAL PORTLAND,,, 2.3
COMPOUND PORTLAND -0.01 HYDROGEN -0.001 CARBON -0.529107 OXYGEN -0.016 SODIUM -0.002 \
	 MAGNESIU -0.033872 ALUMINUM -0.337021 SILICON -0.013 POTASSIU \
	 -0.044 CALCIUM -0.014 IRON
ASSIGNMA , BLCKHOLE BLKBODY,, 1.0 0
ASSIGNMA , VACUUM VOID,, 1 0
ASSIGNMA , IRON SHIELD
ASSIGNMA , HELIUM TCC_CAV
!ASSIGNMA , HELIUM TDEC
ASSIGNMA , HELIUM MBHEnv
ASSIGNMA , IRON MBHFe
ASSIGNMA , VACUUM MBHVac
!ASSIGNMA , IRON TDEC_SLD
!ASSIGNMA , TITANIUM TARGET
!ASSIGNMA , ALUMINUM HORNCo
!ASSIGNMA , AIR INAIR,,,, VACUUM
!ASSIGNMA , BLCKHOLE BLKBODY
!ASSIGNMA , VACUUM VOID
!ASSIGNMA , VACUUM SHIELD
!ASSIGNMA , VACUUM BOX1
!ASSIGNMA , ALUMINUM RHALUP
!ASSIGNMA , VACUUM RHBF,,, 1.
!ASSIGNMA , ALUMINUM RHALDOWN
!ASSIGNMA , VACUUM RHIN
!ASSIGNMA , TITANIUM TARGET
!ASSIGNMA , VACUUM DT
!#else
!ASSIGNMA , BLCKHOLE BLKBODY
!ASSIGNMA , PORTLAND WALL
!ASSIGNMA , TITANIUM TARGET
!ASSIGNMA , AIR INAIR
!ASSIGNMA , BLCKHOLE BLKBODY
!ASSIGNMA , VACUUM VOID
!ASSIGNMA , VACUUM SHIELD
!ASSIGNMA , VACUUM BOX1
!ASSIGNMA , ALUMINUM RHALUP
!ASSIGNMA , VACUUM RHBF,,, 1.
!ASSIGNMA , ALUMINUM RHALDOWN
!ASSIGNMA , VACUUM RHIN
!ASSIGNMA , TITANIUM TARGET
!ASSIGNMA , VACUUM DT
!MAT-PROP USERDIRE 1,,, VACUUM @LASTMAT
* * Activation calculations
* -----------------------
PHYSICS EVAPORAT 3.
PHYSICS COALESCE 1.
*
* Electromagnetic thresholds
* --------------------------
*         prompt     decay
*  e+/-   10 MeV    100keV
*  gamma   5 MeV     50keV
EMFCUT PROD-CUT -1E-05 5E-5 1. VACUUM @LASTMAT
EMFCUT , -1E-05 5E-5,, BLKBODY @LASTREG
*
* Photonuclear interactions
* -------------------------
PHOTONUC , 1.,,, BLCKHOLE @LASTMAT
*
* Hadronic thresholds
* -------------------
PART-THR , -10.0E-6 PROTON APROTON
PART-THR , -10.0E-6 ANEUTRON @LASTPAR
*
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7....+....8
RANDOMIZ , 1. 99999999
START , 10000.,,,, 0.0
STOP
EndInput

