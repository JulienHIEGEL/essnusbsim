!TRC h25 $x1 $y1 $z5 0.0 0.0 $dz $R20 $R21
!TRC h26 $x1 $y1 $z6 0.0 0.0 $dz $R21 $R22
!TRC h27 $x1 $y1 $z7 0.0 0.0 $dz $R22 $R23
!TRC h28 $x1 $y1 $z8 0.0 0.0 $dz $R23 $R24
!TRC h29 $x1 $y1 $z9 0.0 0.0 $dz $R24 $R25
!TRC h30 $x1 $y1 $z0 0.0 0.0 $L11 $h10 $h10
!TRC h31 $x1 $y1 $z1 0.0 0.0 $L2 $h10 $h11
!TRC h32 $x1 $y1 $z2 0.0 0.0 $L3 $h11 $h11
!TRC h33 $x1 $y1 $z3 0.0 0.0 $L4 $h11 $h10
!TRC h34 $x1 $y1 $z4 0.0 0.0 $L5 $h10 $h10
!TRC h35 $x1 $y1 $z5 0.0 0.0 $dz $h10 $R31
!TRC h36 $x1 $y1 $z6 0.0 0.0 $dz $R31 $R32
!TRC h37 $x1 $y1 $z7 0.0 0.0 $dz $R32 $R33
!TRC h38 $x1 $y1 $z8 0.0 0.0 $dz $R33 $R34
!TRC h39 $x1 $y1 $z9 0.0 0.0 $dz $R34 $R35
!RPP dt $hdtm $hdtp $hdtm $hdtp $hdtzm $hdtzp
END
* Black hole
REGION BLKBODY
	+world -around
REGION VOID
	+around -tcc -ttnstorm 
!REGION TCC 5
	+tcc
REGION TTNSTRM 5
	+ttnstorm-tcc
REGION TSHILD 5
	+tcc-thbox -dectube 
REGION THBOX 5
	+thbox -dectube -target 
	@select=1
REGION DECTUBE 5
	+dectube -ttnstorm 
!REGION BOX1 5
	+box1
	-h00 -h01 -h02 -h03 -h04 -h05 -h06 -h07 -h08 -h09-target
!REGION RHALUP 5
	+h00-h20 -h30 -h10-target |+h30 -h10-target
	|+h01-h21 -h31 -h11-target |+h31 -h11-target
	|+h02-h22 -h32 -h12-target |+h32 -h12-target
	|+h03-h23 -h33 -h13-target |+h33 -h13-target
	|+h04-h24 -h34 -h14-target |+h34 -h14-target
	|+h05-h25 -h35 -h15-target |+h35 -h15-target
	|+h06-h26 -h36 -h16-target |+h36 -h16-target
	|+h07-h27 -h37 -h17-target |+h37 -h17-target
	|+h08-h28 -h38 -h18-target |+h38 -h18-target
	|+h09-h29 -h39 -h19-target |+h39 -h19-target
!REGION RHBF 5
	+h20-h30-target
	|+h21-h31-target
	|+h22-h32-target
	|+h23-h33-target
	|+h24-h34-target
	|+h25-h35-target
	|+h26-h36-target
	|+h27-h37-target
