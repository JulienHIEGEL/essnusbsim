#define hdtm -200
#define hezm -200
#define hezp 300
#define hdtzm 300
#define hdtzp 2800
#define dx -200
#define dy -200
#define tdec_rad 60
#define nustrm_inj 4000
#define thbox_rad 120
#define thbox_len 250
#define tdec_len 1000
#define hbox_zmin 6.1
#define tgt_len 78
#define tgt_rad 1.5
*# ---> Beam definition
#define BW =0.2645*tgt_rad
MULSOPT
DEFAULTS NEW-DEFA
*
* Beam definition
* ---------------
*  Gaussian beam, (sigma_x, sigma_y) = (0.05cm, 0.1cm)
BEAM PROTON -2.5 0.0 0.0 =-2.3548*BW =-2.3548*BW 1.
BEAMPOS , 0 0 -1.0 0.0 0.0
*
* Geometry
* --------
GEOBEGIN COMBNAME
* Black body - size 10m
RPP world -1000 1000 -1000 1000 -1000 10000
*Simulation inside this volume - size 1km
RPP around -500 500 -500 500 -150 6000
*Target cavern
RCC tcc 0 0 -10 0 0 =thbox_len+tdec_len+10 250
!XYP PyZtendP =thbox_len+tdec_len
*Beam to leNUSTORM
RCC ttnstorm 0 0 =thbox_len+tdec_len 0 0 =nustrm_inj-(thbox_len+tdec_len) 350
*NuSTORM injection point to observe fluxes
XYP PyZinjP =nustrm_inj-0.001
RCC NSTRMcyl 0 0 =nustrm_inj 0 0 500 250
*Target station (target, horn and decay tube)
RCC thbox 0 0 -0.001 0 0 =thbox_len+0.001 =thbox_rad
RCC dectube 0 0 =thbox_len 0 0 =tdec_len =tdec_rad
!ZCC TGDtube 0 0 =tdec_rad
!XYP TGDend =tcav_zmax+tdec_len
!RCC box1 $x1 $y1 $zb 0.0 0.0 $Lbox $Rbox
!RCC tdecay 0 0 =tcav_zmax-0.1 0 0 =tdec_len =tdec_rad
RCC target 0 0 0.0 0.0 0.0 =tgt_len =tgt_rad
!TRC h00 $x1 0.0 $z00 0.0 0.0 $L10 $R0x $R0x
!TRC h01 $x1 0.0 $z1 0.0 0.0 $L2 $R0x $R0x
!TRC h02 $x1 0.0 $z2 0.0 0.0 $L3 $R0x $R0x
!TRC h03 $x1 0.0 $z3 0.0 0.0 $L4 $R0x $R0x
!TRC h04 $x1 0.0 $z4 0.0 0.0 $L5 $R0x $R00
!TRC h05 $x1 0.0 $z5 0.0 0.0 $dz $R00 $R01
