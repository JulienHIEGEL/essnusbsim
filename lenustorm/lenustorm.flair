# flair project file
Version: 300
Mode: fluka
md5: c5678fe13deb8e8f6c7103be7810f723
Input:
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7...
*
TITLE
	ESSnuSB Beam to LEnuSTORM
*-----
*GEOMETRY parameters
*-----
* Facility
* --------
* Target chamber
* 	length = -1m to +3m = 4ms
* 	width  = 2.5m
* 	shielding width = 4m
#define tcc_len 300
#define tcc_width 250
#define tcc_shield 400
#define tcc_o =tcc_width+tcc_shield
*
* Decay pipe
*	length = 80m
*	radius = 1m
*	shielding = 4m
#define tdec_len 8000
#define tdec_rad 100
#define tdec_shield 400
#define tdec_wid =tdec_rad+tdec_shield
*
* Beam dump
*	length 	= 5m
*	width 	= 3m
#define bdump_len 500
#define bdump_wid 300
*
* ESSnuSB near detector
*	distance (from target) = 250m
#define ndet_dis 25000
#define ndet_wid 500
*
* TTline to leNuSTORM
* -------------------
*
* Magnet prototypes
#define d1_len 221
#define d1_k0 0.428
#define d1_arad =d1_k0*d1_len/100
#define d1_adeg =d1_arad*180/pi
#define d1_b0 =d1_arad*0.7/299.79/d1_len*1.0e5
#define d1_apx =0.5*sin(d1_arad)*d1_len
#define d1_apy =40
#define d1_xsiz =d1_apx*1.20
#define d1_ysiz =d1_apy*1.20
#define d1_arc =d1_len/2/cos(d1_arad/2)**2
#define q1_len 80
#define q1_ap 40
#define q1_fe 20
#define q1_rad =q1_ap+q1_fe + mqa_fe
#define drift1 400
#define drift2 20
#define drift3 20
#define drift4 35.3
#define drift5 35.3
#define drift6 35.3
#define drift7 35.3
#define drift8 20
#define drift9 20
#define s_q1 =drift2
#define s_q2 =s_q1+q1_len+drift3
#define s_q3 =s_q2+q1_len+drift4
#define s_q4 =s_q3+q1_len+drift5
#define s_q5 =s_q4+q1_len+drift6
#define s_q6 =s_q5+q1_len+drift7
#define s_q7 =s_q6+q1_len+drift8
#define s_d2 =s_q7+q1_len+drift9
*
* LEnuSTORM
*	nstorm_ss_len	= 75m
*	nstorm_tun_wid = 4m
#define nstorm_ss_len 7500
#define nstorm_tun_wid 400
*
* Target & Horn
#define thbox_rad 100
#define thbox_zmax 100
#define thbox_zmin -10
*
* Target
#define tgt_rad 1.5
#define tgt_len 78
*
* Horn
#define hon_zmin 6.1
#define h_thick0 1.0
#define h_thick 0.3
#define h_z1 64.98
#define h_z2 46.8
#define h_z3 60.3
#define h_z4 47.5
#define h_z5 1.08
#define h_z6 5.44
#define h_z7 5.44
#define h_z8 5.44
#define h_z9 5.44
#define h_z10 5.74
#define h_ltot '=h_z1+h_z2+h_z3+h_z4+h_z5+h_z6+h_z7+h_z8+h_z9+h_z10 '
#define h_rin1 3.0
#define h_rin2 22.1
#define h_rin3 3.54
#define h_rin4 5.24
#define h_rin5 8.37
#define h_rin6 13.86
#define h_rin7 30.5
#define h_rout1 57.7
#define h_rout2 57.15
#define h_rout3 55.43
#define h_rout4 52.26
#define h_rout5 46.82
#define h_rout6 30.5
#define h_romax =57.7+h_thick0
#define h_rimin =h_rin1
* ---------
MULSOPT
DEFAULTS NEW-DEFA
*Beam definition
* ---------------
*  Gaussian beam, 2.5GeV, (sigma_x, sigma_y) = (0.05cm, 0.1cm)
BEAM PROTON -0.7 0.0 0.0 0 0 1.0
BEAMPOS , 0 0 0 0.0 0.0
*
* Geometry
* --------
GEOBEGIN COMBNAME
* Black body - size 100m
SPH blkbody 0 0 0 100000
SPH void 0 0 0 90000
RPP tcc_o -$tcc_o $tcc_o -$tcc_o $tcc_o -100 $tcc_len
RPP modo 800 3000 -200 200 -200 1000
RPP modi 850 2950 -150 150 -150 950
RPP tcc -$tcc_width $tcc_width -$tcc_width $tcc_width -50 =tcc_len+1
RPP tdec_o -$tdec_wid $tdec_wid -$tdec_wid $tdec_wid =tcc_len-1 =tdec_len+1
RCC tdec 0 0 =tcc_len-2 0 0 =tdec_len-bdump_len+2 $tdec_rad
*Target & Horn box
RCC thbox 0 0 $thbox_zmin 0 0 $thbox_zmax $thbox_rad
RCC target 0 0 0 0 0 $tgt_len $tgt_rad
*---- Magnet Models -----
$start_translat 1000 0 0
*MBAH Magnet envelop (+1mm bigger) - includes coils
RPP D1Vol =-d1_xsiz/2-0.1 =d1_xsiz/2+0.1 =-d1_ysiz/2-0.1 =d1_ysiz/2+0.1 =-0.1 \
	 =d1_len+0.1
RPP D1Fe =-d1_xsiz/2 =d1_xsiz/2 =-d1_ysiz/2 =d1_ysiz/2 0 =d1_len
RPP D1Vac =-d1_apx/2 =d1_apx/2 =-d1_apy/2 =d1_apy/2 -0.05 =d1_len+0.05
$end_translat
$start_translat 1200 0 0
RCC Q1Vol 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
RCC Q1Fe 0 0 0 0 0 =q1_len =q1_rad
RCC Q1Vac 0 0 -0.05 0 0 =q1_len+0.1 =q1_ap
$end_translat
*
* ------------- Beam line magnets ----------------------------
* D1 dipole
$start_transform -ttd1
$start_translat 1000
*-- empty MBHA container for the lattice (replica)
RPP MBHA =-d1_xsiz/2-0.1 =d1_xsiz/2+0.1 =-d1_ysiz/2-0.1 =d1_ysiz/2+0.1 =-0.1 \
	 =d1_len+0.1
$end_translat
$end_transform
*decay pipe shielding penetration
$start_transform ttsegb
ZCC ttex 0 0 =q1_rad*1.5
$end_transform
YZP ttexi =-tdec_rad
YZP ttexo =-tdec_rad-tdec_shield
* Q1 quad
$start_transform -q1segb
$start_translat 1200
RCC MQA1,, 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
* Q2 quad
$start_transform -q2segb
$start_translat 1200
RCC MQA2,, 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
* Q3 quad
$start_transform -q3segb
$start_translat 1200
RCC MQA3,, 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
* Q4 quad
$start_transform -q4segb
$start_translat 1200
RCC MQA4,, 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
* Q5 quad
$start_transform -q5segb
$start_translat 1200
RCC MQA5,, 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
* Q6 quad
$start_transform -q6segb
$start_translat 1200
RCC MQA6,, 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
* Q7 quad
$start_transform -q7segb
$start_translat 1200
RCC MQA7,, 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
$start_transform -ttd2
$start_translat 1000
RPP MBHB =-d1_xsiz/2 =d1_xsiz/2+0.1 =-d1_ysiz/2-0.1 =d1_ysiz/2+0.1 =-0.1 =d1_len+0.1
$end_translat
$end_transform
*
!RCC MQA2 0 0 0 0 0 =mqa_len+0.2 =mqa_rad+0.1
END
* Black hole
REGION BLKBODY
	+blkbody -void
REGION VOID
	+void -modo -tcc_o -tdec_o -MQA5 -MQA6 -MQA7 -MBHB    
	@select=1
REGION MOBLK
	+modo -modi 
REGION MODELS
	+modi -D1Vol -Q1Vol  
REGION SHIELD
	+tcc_o -tcc
	| +tdec_o -tcc_o -tcc -tdec -(+ttex +ttexi)  
REGION TCC_CAV 5
	+tcc -thbox -MBHA 
	| +tdec -MBHA -MQA1
	| +ttex +ttexi -ttexo -MQA1 -MQA2 -MQA3 -MQA4 -MQA5 
!REGION TDEC 5
	+tdec -tcc -MBHA 
REGION MBHEnv
	+D1Vol -D1Fe -D1Vac 
REGION MBHFe
	+D1Fe -D1Vac 
REGION MBHVac
	+D1Vac 
REGION MQAEnv
	+Q1Vol -Q1Fe -Q1Vac 
REGION MQAFe
	+Q1Fe -Q1Vac 
REGION MQAVac
	+Q1Vac  
*
REGION THBOX 5
	+thbox -target
REGION TARGET 5
	+target 
REGION MBHA 5
	+MBHA  
REGION MQA1 5
	+MQA1  
REGION MQA2 5
	+MQA2  
REGION MQA3 5
	+MQA3  
REGION MQA4 5
	+MQA4  
REGION MQA5 5
	+MQA5 
REGION MQA6 5
	+MQA6  
REGION MQA7 5
	+MQA7
REGION MBHB 5
	+MBHB
LATTICE ttd1 MBHA,,, MBHA
LATTICE q1segb MQA1,,, MQA1
LATTICE q2segb MQA2,,, MQA2
LATTICE q3segb MQA3,,, MQA3
LATTICE q4segb MQA4,,, MQA4
LATTICE q5segb MQA5,,, MQA5
LATTICE q6segb MQA6,,, MQA6
LATTICE q7segb MQA7,,, MQA7
LATTICE ttd2 MBHB,,, MBHB
*
GEOEND
*
ASSIGNMA , BLCKHOLE BLKBODY,, 1.0 0
ASSIGNMA , VACUUM VOID,, 1 0
ASSIGNMA , BLCKHOLE MOBLK,, 1 0
ASSIGNMA , VACUUM MODELS,, 1 0
ASSIGNMA , IRON SHIELD
ASSIGNMA , HELIUM TCC_CAV
ASSIGNMA , TITANIUM TARGET
ASSIGNMA , HYDROGEN THBOX
ASSIGNMA , HELIUM MBHEnv
ASSIGNMA , IRON MBHFe
ASSIGNMA , VACUUM MBHVac,,, 1
MGNCREAT MFIELD 2
MGNFIELD MFIELD =d1_b0,, 0 MBHVac MBHVac
ASSIGNMA , VACUUM MQAEnv
ASSIGNMA , IRON MQAFe
ASSIGNMA , VACUUM MQAVac
!ASSIGNMA , IRON TDEC_SLD
** ---- ROT-DEFI
ROT-DEFI ttd1,,,, =d1_arc/2*sin(d1_arad/2),, =d1_arc/2*cos(d1_arad/2)
!ROT-DEFI ttd1 200 0 =-d1_adeg/2 0 0
ROT-DEFI ttd1,,,, =1000,, =-drift1
ROT-DEFI ttd2,,,, =(d1_arc+s_d2)*sin(d1_arad),, =-d1_arc-(d1_arc+s_d2)*cos(d1_arad)
!ROT-DEFI ttd2 200 0 =-d1_adeg/2 0 0
ROT-DEFI ttd2,,,, =1000,, =-drift1
ROT-DEFI ttsegb 200,, =d1_adeg
ROT-DEFI ttsegb,,,,,, =drift1+d1_arc
*
ROT-DEFI q1segb 300,,, =(d1_arc+s_q1)*sin(d1_arad) 0 =-drift1-d1_arc-(d1_arc+s_q1)*cos(d1_arad)
ROT-DEFI q1segb 200,, =-d1_adeg,, 0
ROT-DEFI q1segb 300,,, 1200,, 0
*
ROT-DEFI q2segb 0,,, =(d1_arc+s_q2)*sin(d1_arad) 0 =-drift1-d1_arc-(d1_arc+s_q2)*cos(d1_arad)
ROT-DEFI q2segb 200,, =-d1_adeg,, 0 0
ROT-DEFI q2segb 300,,, 1200,, 0
*
ROT-DEFI q3segb 0,,, =(d1_arc+s_q3)*sin(d1_arad) 0 =-drift1-d1_arc-(d1_arc+s_q3)*cos(d1_arad)
ROT-DEFI q3segb 200,, =-d1_adeg,, 0 0
ROT-DEFI q3segb 300,,, 1200,, 0
*
ROT-DEFI q4segb 0,,, =(d1_arc+s_q4)*sin(d1_arad) 0 =-drift1-d1_arc-(d1_arc+s_q4)*cos(d1_arad)
ROT-DEFI q4segb 200,, =-d1_adeg,, 0 0
ROT-DEFI q4segb 300,,, 1200,, 0
*
ROT-DEFI q5segb 0,,, =(d1_arc+s_q5)*sin(d1_arad) 0 =-drift1-d1_arc-(d1_arc+s_q5)*cos(d1_arad)
ROT-DEFI q5segb 200,, =-d1_adeg,, 0 0
ROT-DEFI q5segb 300,,, 1200,, 0
*
ROT-DEFI q6segb 0,,, =(d1_arc+s_q6)*sin(d1_arad) 0 =-drift1-d1_arc-(d1_arc+s_q6)*cos(d1_arad)
ROT-DEFI q6segb 200,, =-d1_adeg,, 0 0
ROT-DEFI q6segb 300,,, 1200,, 0
*
ROT-DEFI q7segb 0,,, =(d1_arc+s_q7)*sin(d1_arad) 0 =-drift1-d1_arc-(d1_arc+s_q7)*cos(d1_arad)
ROT-DEFI q7segb 200,, =-d1_adeg,, 0 0
ROT-DEFI q7segb 300,,, 1200,, 0
*
*
!MAT-PROP USERDIRE 1,,, VACUUM @LASTMAT
* * Activation calculations
* -----------------------
PHYSICS EVAPORAT 3.
PHYSICS COALESCE 1.
*
* Electromagnetic thresholds
* --------------------------
*         prompt     decay
*  e+/-   10 MeV    100keV
*  gamma   5 MeV     50keV
EMFCUT PROD-CUT -1E-05 5E-5 1. VACUUM @LASTMAT
EMFCUT , -1E-05 5E-5,, BLKBODY @LASTREG
*
* Photonuclear interactions
* -------------------------
PHOTONUC , 1.,,, BLCKHOLE @LASTMAT
*
* Hadronic thresholds
* -------------------
PART-THR , -10.0E-6 PROTON APROTON
PART-THR , -10.0E-6 ANEUTRON @LASTPAR
*
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7....+....8
RANDOMIZ , 1. 99999999
START , 10000.,,,, 0.0
*
* --- obsolete defines
*
