	|+h29-h39-target
!REGION RHALDOWN 5
	+h30 -h20-target
	|+h31 -h21-target
	|+h32 -h22-target
	|+h33 -h23-target
	|+h34 -h24-target
	|+h35 -h25-target
	|+h36 -h26-target
	|+h37 -h27-target
	|+h38 -h28-target
	|+h39 -h29-target
!REGION RHIN 5
	+h10-target   |+h11-target   |+h12-target   |+h13-target  |+h14-target
	|+h15-target  |+h16 -target |+h17 -target |+h18 -target  |+h19-target
REGION TARGET 5
	+target
!REGION DT 5
	+dt
END
GEOEND
*
* Material definitions
* --------------------
MATERIAL POTASSIU 19. 39.0983 0.862
MATERIAL CHROMIUM 24. 51.9961 7.18
MATERIAL MANGANES 25. 54.938049 7.21
MATERIAL PHOSPHO 15. 30.973761 1.82
MATERIAL SULFUR 16. 32.066 2.07
* Steel316LN
* Stainless steel AISI316LN
MATERIAL SS316LN,,, 7.8
COMPOUND SS316LN -0.67145 IRON -0.185 CHROMIUM -0.1125 NICKEL -0.02 MANGANES -0.01 \
	 SILICON -0.00045 PHOSPHO -0.0003 SULFUR -0.0003 CARBON
*
* Concrete portland
* -----------------
MATERIAL PORTLAND,,, 2.3
COMPOUND PORTLAND -0.01 HYDROGEN -0.001 CARBON -0.529107 OXYGEN -0.016 SODIUM -0.002 \
	 MAGNESIU -0.033872 ALUMINUM -0.337021 SILICON -0.013 POTASSIU \
	 -0.044 CALCIUM -0.014 IRON
ASSIGNMA , BLCKHOLE BLKBODY,, 1.0 0
ASSIGNMA , VACUUM VOID,, 1 0
ASSIGNMA , HELIUM TTNSTRM
ASSIGNMA , BLCKHOLE TSHILD
ASSIGNMA , HELIUM THBOX
ASSIGNMA , HELIUM DECTUBE
!ASSIGNMA , TITANIUM TARGET,,,, VACUUM
!ASSIGNMA , AIR INAIR,,,, VACUUM
!ASSIGNMA , BLCKHOLE BLKBODY
!ASSIGNMA , VACUUM VOID
!ASSIGNMA , VACUUM TCC
!ASSIGNMA , VACUUM BOX1
!ASSIGNMA , ALUMINUM RHALUP
!ASSIGNMA , VACUUM RHBF,,, 1.
!ASSIGNMA , ALUMINUM RHALDOWN
!ASSIGNMA , VACUUM RHIN
!ASSIGNMA , TITANIUM TARGET
!ASSIGNMA , VACUUM DT
!#else
!ASSIGNMA , BLCKHOLE BLKBODY
!ASSIGNMA , PORTLAND WALL
!ASSIGNMA , TITANIUM TARGET
!ASSIGNMA , AIR INAIR
!ASSIGNMA , BLCKHOLE BLKBODY
!ASSIGNMA , VACUUM VOID
!ASSIGNMA , VACUUM TCC
!ASSIGNMA , VACUUM BOX1
!ASSIGNMA , ALUMINUM RHALUP
!ASSIGNMA , VACUUM RHBF,,, 1.
!ASSIGNMA , ALUMINUM RHALDOWN
!ASSIGNMA , VACUUM RHIN
!ASSIGNMA , TITANIUM TARGET
!ASSIGNMA , VACUUM DT
!MAT-PROP USERDIRE 1,,, VACUUM @LASTMAT
* * Activation calculations
* -----------------------
PHYSICS EVAPORAT 3.
PHYSICS COALESCE 1.
*
* Electromagnetic thresholds
* --------------------------
*         prompt     decay
*  e+/-   10 MeV    100keV
*  gamma   5 MeV     50keV
EMFCUT PROD-CUT -1E-05 5E-5 1. VACUUM @LASTMAT
EMFCUT , -1E-05 5E-5,, BLKBODY @LASTREG
*
* Photonuclear interactions
* -------------------------
PHOTONUC , 1.,,, BLCKHOLE @LASTMAT
*
* Hadronic thresholds
* -------------------
PART-THR , -10.0E-6 PROTON APROTON
PART-THR , -10.0E-6 ANEUTRON @LASTPAR
*
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7....+....8
RANDOMIZ , 1. 99999999
START , 10000.,,,, 0.0
STOP
EndInput

