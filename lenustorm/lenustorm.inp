* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7...
*
TITLE
ESSnuSB Beam to LEnuSTORM
*-----
*GEOMETRY parameters
*-----
* Facility
* --------
* Target chamber
* 	length = -1m to +3m = 4ms
* 	width  = 2.5m
* 	shielding width = 4m
#define tcc_len 300
#define tcc_width 250
#define tcc_shield 400
!@what.1=tcc_width+tcc_shield
#define tcc_o 650
*
* Decay pipe
*	length = 80m
*	radius = 1m
*	shielding = 4m
#define tdec_len 8000
#define tdec_rad 100
#define tdec_shield 400
!@what.1=tdec_rad+tdec_shield
#define tdec_wid 500
*
* Beam dump
*	length 	= 5m
*	width 	= 3m
#define bdump_len 500
#define bdump_wid 300
*
* ESSnuSB near detector
*	distance (from target) = 250m
#define ndet_dis 25000
#define ndet_wid 500
*
* TTline to leNuSTORM
* -------------------
*
* Magnet prototypes
#define d1_len 221
#define d1_k0 0.428
!@what.1=d1_k0*d1_len/100
#define d1_arad 0.94588
!@what.1=d1_arad*180/pi
#define d1_adeg 54.1949319258343
!@what.1=d1_arad*0.7/299.79/d1_len*1.0e5
#define d1_b0 0.999366223022783
!@what.1=0.5*sin(d1_arad)*d1_len
#define d1_apx 89.616834136162
!@what.1=40
#define d1_apy 40
!@what.1=d1_apx*1.20
#define d1_xsiz 107.5402009633944
!@what.1=d1_apy*1.20
#define d1_ysiz 48
!@what.1=d1_len/2/cos(d1_arad/2)**2
#define d1_arc 139.429589070911
#define q1_len 80
#define q1_ap 40
#define q1_fe 20
!@what.1=q1_ap+q1_fe
#define q1_rad 60
#define drift1 400
#define drift2 20
#define drift3 20
#define drift4 35.3
#define drift5 35.3
#define drift6 35.3
#define drift7 35.3
#define drift8 20
#define drift9 20
!@what.1=drift2
#define s_q1 20
!@what.1=s_q1+q1_len+drift3
#define s_q2 120
!@what.1=s_q2+q1_len+drift4
#define s_q3 235.3
!@what.1=s_q3+q1_len+drift5
#define s_q4 350.6
!@what.1=s_q4+q1_len+drift6
#define s_q5 465.9
!@what.1=s_q5+q1_len+drift7
#define s_q6 581.2
!@what.1=s_q6+q1_len+drift8
#define s_q7 681.2
!@what.1=s_q7+q1_len+drift9
#define s_d2 781.2
*
* LEnuSTORM
*	nstorm_ss_len	= 75m
*	nstorm_tun_wid = 4m
#define nstorm_ss_len 7500
#define nstorm_tun_wid 400
*
* Target & Horn
#define thbox_rad 100
#define thbox_zmax 100
#define thbox_zmin -10
*
* Target
#define tgt_rad 1.5
#define tgt_len 78
*
* Horn
#define hon_zmin 6.1
#define h_thick0 1
#define h_thick 0.3
#define h_z1 64.98
#define h_z2 46.8
#define h_z3 60.3
#define h_z4 47.5
#define h_z5 1.08
#define h_z6 5.44
#define h_z7 5.44
#define h_z8 5.44
#define h_z9 5.44
#define h_z10 5.74
!@what.1=h_z1+h_z2+h_z3+h_z4+h_z5+h_z6+h_z7+h_z8+h_z9+h_z10 
#define h_ltot 248.16
#define h_rin1 3
#define h_rin2 22.1
#define h_rin3 3.54
#define h_rin4 5.24
#define h_rin5 8.37
#define h_rin6 13.86
#define h_rin7 30.5
#define h_rout1 57.7
#define h_rout2 57.15
#define h_rout3 55.43
#define h_rout4 52.26
#define h_rout5 46.82
#define h_rout6 30.5
!@what.1=57.7+h_thick0
#define h_romax 58.7
!@what.1=h_rin1
#define h_rimin 3
* ---------
MULSOPT
DEFAULTS                                                              NEW-DEFA
*Beam definition
* ---------------
*  Gaussian beam, 2.5GeV, (sigma_x, sigma_y) = (0.05cm, 0.1cm)
BEAM            -0.7       0.0       0.0         0         0       1.0PROTON
BEAMPOS            0         0         0       0.0       0.0
*
* Geometry
* --------
GEOBEGIN                                                              COMBNAME
    0    0          
* Black body - size 100m
SPH blkbody    0 0 0 100000
SPH void       0 0 0 90000
RPP tcc_o      -$tcc_o $tcc_o -$tcc_o $tcc_o -100 $tcc_len
RPP modo       800 3000 -200 200 -200 1000
RPP modi       850 2950 -150 150 -150 950
!@what.6=tcc_len+1
RPP tcc        -$tcc_width $tcc_width -$tcc_width $tcc_width -50 301
!@what.5=tcc_len-1
!@what.6=tdec_len+1
RPP tdec_o     -$tdec_wid $tdec_wid -$tdec_wid $tdec_wid 299 8001
!@what.3=tcc_len-2
!@what.6=tdec_len-bdump_len+2
RCC tdec       0 0 298 0 0 7502 $tdec_rad
*Target & Horn box
RCC thbox      0 0 $thbox_zmin 0 0 $thbox_zmax $thbox_rad
RCC target     0 0 0 0 0 $tgt_len $tgt_rad
*---- Magnet Models -----
$start_translat 1000 0 0
*MBAH Magnet envelop (+1mm bigger) - includes coils
!@what.1=-d1_xsiz/2-0.1
!@what.2=d1_xsiz/2+0.1
!@what.3=-d1_ysiz/2-0.1
!@what.4=d1_ysiz/2+0.1
!@what.6=d1_len+0.1
RPP D1Vol      -53.8701004816972 53.8701004816972 -24.1 24.1 -0.1 221.1
!@what.1=-d1_xsiz/2
!@what.2=d1_xsiz/2
!@what.3=-d1_ysiz/2
!@what.4=d1_ysiz/2
RPP D1Fe       -53.7701004816972 53.7701004816972 -24 24 0 $d1_len
!@what.1=-d1_apx/2
!@what.2=d1_apx/2
!@what.3=-d1_apy/2
!@what.4=d1_apy/2
!@what.6=d1_len+0.05
RPP D1Vac      -44.808417068081 44.808417068081 -20 20 -0.05 221.05
$end_translat
$start_translat 1200 0 0
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC Q1Vol      0 0 -0.1 0 0 80.2 60.1
RCC Q1Fe       0 0 0 0 0 $q1_len $q1_rad
!@what.6=q1_len+0.1
RCC Q1Vac      0 0 -0.05 0 0 80.1 $q1_ap
$end_translat
*
* ------------- Beam line magnets ----------------------------
* D1 dipole
$start_transform -ttd1
$start_translat 1000
*-- empty MBHA container for the lattice (replica)
!@what.1=-d1_xsiz/2-0.1
!@what.2=d1_xsiz/2+0.1
!@what.3=-d1_ysiz/2-0.1
!@what.4=d1_ysiz/2+0.1
!@what.6=d1_len+0.1
RPP MBHA       -53.8701004816972 53.8701004816972 -24.1 24.1 -0.1 221.1
$end_translat
$end_transform
*decay pipe shielding penetration
$start_transform ttsegb
!@what.3=q1_rad*1.5
ZCC ttex       0 0 90
$end_transform
YZP ttexi      -$tdec_rad
!@what.1=-tdec_rad-tdec_shield
YZP ttexo      -500
* Q1 quad
$start_transform -q1segb
$start_translat 1200
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC MQA1       0.0 0 -0.1 0 0 80.2 60.1
$end_translat
$end_transform
* Q2 quad
$start_transform -q2segb
$start_translat 1200
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC MQA2       0.0 0 -0.1 0 0 80.2 60.1
$end_translat
$end_transform
* Q3 quad
$start_transform -q3segb
$start_translat 1200
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC MQA3       0.0 0 -0.1 0 0 80.2 60.1
$end_translat
$end_transform
* Q4 quad
$start_transform -q4segb
$start_translat 1200
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC MQA4       0.0 0 -0.1 0 0 80.2 60.1
$end_translat
$end_transform
* Q5 quad
$start_transform -q5segb
$start_translat 1200
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC MQA5       0.0 0 -0.1 0 0 80.2 60.1
$end_translat
$end_transform
* Q6 quad
$start_transform -q6segb
$start_translat 1200
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC MQA6       0.0 0 -0.1 0 0 80.2 60.1
$end_translat
$end_transform
* Q7 quad
$start_transform -q7segb
$start_translat 1200
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC MQA7       0.0 0 -0.1 0 0 80.2 60.1
$end_translat
$end_transform
$start_transform -ttd2
$start_translat 1000
!@what.1=-d1_xsiz/2
!@what.2=d1_xsiz/2+0.1
!@what.3=-d1_ysiz/2-0.1
!@what.4=d1_ysiz/2+0.1
!@what.6=d1_len+0.1
RPP MBHB       -53.7701004816972 53.8701004816972 -24.1 24.1 -0.1 221.1
$end_translat
$end_transform
#if 0
*
!@what.6=mqa_len+0.2
!@what.7=mqa_rad+0.1
RCC MQA2       0 0 0 0 0 0.0 0.0
#endif
#if 0
!@what.3=h_rout1+h_thick0
ZCC horn_O0    0 0 58.7
#endif
#if 0
ZCC horn_O1    0 0 $h_rout1
#endif
#if 0
!@what.1=shift_horn
XYP PyZhuP1    0.0
#endif
#if 0
!@what.1=shift_horn+h_thick0
XYP PyZhuP2    0.0
#endif
#if 0
!@what.1=shift_horn+h_thick0+h_z1+h_z2+h_z3+h_z4+h_z5
XYP PyZhoP     0.0
#endif
#if 0
!@what.3=h_rin1+h_thick
ZCC horn_I0    0 0 3.3
#endif
#if 0
ZCC horn_I1    0 0 $h_rin1
#endif
#if 0
!@what.1=shift_horn+h_thick+h_z1
XYP PyZhiP1    0.0
#endif
*$end_translat
#if 0
TRC h00        $x1 0.0 $z00 0.0 0.0 $L10 $R0x $R0x
#endif
#if 0
TRC h01        $x1 0.0 $z1 0.0 0.0 $L2 $R0x $R0x
#endif
#if 0
TRC h02        $x1 0.0 $z2 0.0 0.0 $L3 $R0x $R0x
#endif
#if 0
TRC h03        $x1 0.0 $z3 0.0 0.0 $L4 $R0x $R0x
#endif
#if 0
TRC h04        $x1 0.0 $z4 0.0 0.0 $L5 $R0x $R00
#endif
#if 0
