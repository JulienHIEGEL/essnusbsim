* Black hole
BLKBODY      5 +world -around
VOID         5 +around -tcc -ttnstorm
#if 0
TCC          5 +tcc
#endif
TTNSTRM      5 +ttnstorm-tcc
TSHILD       5 +tcc-thbox -dectube
THBOX        5 +thbox -dectube -target
DECTUBE      5 +dectube -ttnstorm
#if 0
BOX1         5 +box1
               -h00 -h01 -h02 -h03 -h04 -h05 -h06 -h07 -h08 -h09-target
#endif
#if 0
