* Black hole
BLKBODY      5 +blkbody -void
VOID         5 +void -modo -tcc_o -tdec_o -MQA5 -MQA6 -MQA7 -MBHB
MOBLK        5 +modo -modi
MODELS       5 +modi -D1Vol -Q1Vol
SHIELD       5 +tcc_o -tcc
               | +tdec_o -tcc_o -tcc -tdec -(+ttex +ttexi)
TCC_CAV      5 +tcc -thbox -MBHA
               | +tdec -MBHA -MQA1
               | +ttex +ttexi -ttexo -MQA1 -MQA2 -MQA3 -MQA4 -MQA5
#if 0
TDEC         5 +tdec -tcc -MBHA
#endif
MBHEnv       5 +D1Vol -D1Fe -D1Vac
MBHFe        5 +D1Fe -D1Vac
MBHVac       5 +D1Vac
MQAEnv       5 +Q1Vol -Q1Fe -Q1Vac
MQAFe        5 +Q1Fe -Q1Vac
MQAVac       5 +Q1Vac
*
THBOX        5 +thbox -target
TARGET       5 +target
MBHA         5 +MBHA
MQA1         5 +MQA1
MQA2         5 +MQA2
MQA3         5 +MQA3
MQA4         5 +MQA4
MQA5         5 +MQA5
MQA6         5 +MQA6
MQA7         5 +MQA7
MBHB         5 +MBHB
#if 0
HBOX         5 +thbox -target
               -(+horn_O1 -horn_I0 -PyZhuP1 +PyZhuP2 )
               -(+horn_O0 -horn_O1 +PyZhoP -PyZhuP1  )
               -(+horn_I0 -horn_I1 -PyZhuP1  +PyZhiP1 )
#endif
#if 0
TARGET       5 +target
#endif
#if 0
HORNCo       5 +horn_O1 -horn_I0 -PyZhuP1 +PyZhuP2
               | +horn_O0 -horn_O1 +PyZhoP -PyZhuP1
               | +horn_I0 -horn_I1 -PyZhuP1  +PyZhiP1
#endif
#if 0
DECTUBE      5 +tdec
#endif
#if 0
BOX1         5 +box1
               -h00 -h01 -h02 -h03 -h04 -h05 -h06 -h07 -h08 -h09-target
#endif
#if 0
RHALUP       5 +h00-h20 -h30 -h10-target |+h30 -h10-target
               |+h01-h21 -h31 -h11-target |+h31 -h11-target
               |+h02-h22 -h32 -h12-target |+h32 -h12-target
               |+h03-h23 -h33 -h13-target |+h33 -h13-target
               |+h04-h24 -h34 -h14-target |+h34 -h14-target
               |+h05-h25 -h35 -h15-target |+h35 -h15-target
               |+h06-h26 -h36 -h16-target |+h36 -h16-target
               |+h07-h27 -h37 -h17-target |+h37 -h17-target
               |+h08-h28 -h38 -h18-target |+h38 -h18-target
               |+h09-h29 -h39 -h19-target |+h39 -h19-target
#endif
#if 0
RHBF         5 +h20-h30-target
               |+h21-h31-target
               |+h22-h32-target
               |+h23-h33-target
               |+h24-h34-target
               |+h25-h35-target
               |+h26-h36-target
               |+h27-h37-target
               |+h28-h38-target
               |+h29-h39-target
