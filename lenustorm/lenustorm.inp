RHIN         5 +h10-target   |+h11-target   |+h12-target   |+h13-target  |+h14-target
               |+h15-target  |+h16 -target |+h17 -target |+h18 -target  |+h19-target
#endif
#if 0
DT           5 +dt
#endif
END
LATTICE         MBHA                          MBHA                    ttd1
LATTICE         MQA1                          MQA1                    q1segb
LATTICE         MQA2                          MQA2                    q2segb
LATTICE         MQA3                          MQA3                    q3segb
LATTICE         MQA4                          MQA4                    q4segb
LATTICE         MQA5                          MQA5                    q5segb
LATTICE         MQA6                          MQA6                    q6segb
LATTICE         MQA7                          MQA7                    q7segb
LATTICE         MBHB                          MBHB                    ttd2
*
GEOEND
*
ASSIGNMA    BLCKHOLE   BLKBODY                 1.0         0
ASSIGNMA      VACUUM      VOID                   1         0
ASSIGNMA    BLCKHOLE     MOBLK                   1         0
ASSIGNMA      VACUUM    MODELS                   1         0
ASSIGNMA        IRON    SHIELD
ASSIGNMA      HELIUM   TCC_CAV
ASSIGNMA    TITANIUM    TARGET
ASSIGNMA    HYDROGEN     THBOX
ASSIGNMA      HELIUM    MBHEnv
ASSIGNMA        IRON     MBHFe
ASSIGNMA      VACUUM    MBHVac                             1
MGNCREAT           2                                                  MFIELD
MGNFIELD      $d1_b0                   0    MBHVac    MBHVac          MFIELD
ASSIGNMA      VACUUM    MQAEnv
ASSIGNMA        IRON     MQAFe
ASSIGNMA      VACUUM    MQAVac
*ASSIGNMA        IRON  TDEC_SLD
** ---- ROT-DEFI
!@what.4=d1_arc/2*sin(d1_arad/2)
!@what.6=d1_arc/2*cos(d1_arad/2)
ROT-DEFI                                31.7554748          62.0624073ttd1
!@what.3=-d1_adeg/2
*ROT-DEFI         200         0-27.097466         0         0          ttd1
ROT-DEFI                                      1000            -$drift1ttd1
!@what.4=(d1_arc+s_d2)*sin(d1_arad)
!@what.6=-d1_arc-(d1_arc+s_d2)*cos(d1_arad)
ROT-DEFI                                746.641712          -678.02498ttd2
!@what.3=-d1_adeg/2
*ROT-DEFI         200         0-27.097466         0         0          ttd2
ROT-DEFI                                      1000            -$drift1ttd2
ROT-DEFI         200            $d1_adeg                              ttsegb
!@what.6=drift1+d1_arc
ROT-DEFI                                                    539.429589ttsegb
*
!@what.4=(d1_arc+s_q1)*sin(d1_arad)
!@what.6=-drift1-d1_arc-(d1_arc+s_q1)*cos(d1_arad)
ROT-DEFI         300                    129.299322         0-632.70059q1segb
ROT-DEFI         200           -$d1_adeg                   0          q1segb
ROT-DEFI         300                          1200                   0q1segb
*
!@what.4=(d1_arc+s_q2)*sin(d1_arad)
!@what.6=-drift1-d1_arc-(d1_arc+s_q2)*cos(d1_arad)
ROT-DEFI           0                    210.400529         0-691.20353q2segb
ROT-DEFI         200           -$d1_adeg                   0         0q2segb
ROT-DEFI         300                          1200                   0q2segb
*
!@what.4=(d1_arc+s_q3)*sin(d1_arad)
!@what.6=-drift1-d1_arc-(d1_arc+s_q3)*cos(d1_arad)
ROT-DEFI           0                    303.910221         0-758.65742q3segb
ROT-DEFI         200           -$d1_adeg                   0         0q3segb
ROT-DEFI         300                          1200                   0q3segb
*
!@what.4=(d1_arc+s_q4)*sin(d1_arad)
