*# ---> Beam definition
!@what.1=0.2645*tgt_rad
#define BW 0.39675
MULSOPT
DEFAULTS                                                              NEW-DEFA
*
* Beam definition
* ---------------
*  Gaussian beam, (sigma_x, sigma_y) = (0.05cm, 0.1cm)
!@what.4=-2.3548*BW
!@what.5=-2.3548*BW
BEAM            -2.5       0.0       0.0-0.9342669-0.9342669        1.PROTON
BEAMPOS            0         0      -1.0       0.0       0.0
*
* Geometry
* --------
GEOBEGIN                                                              COMBNAME
    0    0          
* Black body - size 10m
RPP world      -1000 1000 -1000 1000 -1000 10000
*Simulation inside this volume - size 1km
RPP around     -500 500 -500 500 -150 6000
*Target cavern
!@what.6=thbox_len+tdec_len+10
RCC tcc        0 0 -10 0 0 1260 250
#if 0
!@what.1=thbox_len+tdec_len
XYP PyZtendP   1250
#endif
*Beam to leNUSTORM
!@what.3=thbox_len+tdec_len
!@what.6=nustrm_inj-(thbox_len+tdec_len)
RCC ttnstorm   0 0 1250 0 0 2750 350
*NuSTORM injection point to observe fluxes
!@what.1=nustrm_inj-0.001
XYP PyZinjP    3999.999
!@what.3=nustrm_inj
RCC NSTRMcyl   0 0 4000 0 0 500 250
*Target station (target, horn and decay tube)
!@what.6=thbox_len+0.001
RCC thbox      0 0 -0.001 0 0 250.001 $thbox_rad
RCC dectube    0 0 $thbox_len 0 0 $tdec_len $tdec_rad
#if 0
ZCC TGDtube    0 0 $tdec_rad
#endif
#if 0
!@what.1=tcav_zmax+tdec_len
XYP TGDend     0.0
#endif
#if 0
RCC box1       $x1 $y1 $zb 0.0 0.0 $Lbox $Rbox
#endif
#if 0
!@what.3=tcav_zmax-0.1
RCC tdecay     0 0 0.0 0 0 $tdec_len $tdec_rad
#endif
RCC target     0 0 0.0 0.0 0.0 $tgt_len $tgt_rad
#if 0
TRC h00        $x1 0.0 $z00 0.0 0.0 $L10 $R0x $R0x
