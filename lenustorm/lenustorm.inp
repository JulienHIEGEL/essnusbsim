#if 0
RPP dt         $hdtm $hdtp $hdtm $hdtp $hdtzm $hdtzp
#endif
END
* Black hole
BLKBODY      5 +blkbody -void
VOID         5 +void -tcc_o -tdec_o -D1Vol -Q1Vol
SHIELD       5 +tcc_o -tcc
               | +tdec_o -tcc_o -tcc -tdec -(+ttex +ttexi)
TCC_CAV      5 +tcc -thbox -MBHA
               | +tdec -MBHA -MQA1
               | +ttex +ttexi -ttexo -MQA1 -MQA2
#if 0
TDEC         5 +tdec -tcc -MBHA
#endif
THBOX        5 +thbox -target
TARGET       5 +target
MBHA         5 +MBHA
MQA1         5 +MQA1
MQA2         5 +MQA2
MBHEnv       5 +D1Vol -D1Fe -D1Vac
MBHFe        5 +D1Fe -D1Vac
MBHVac       5 +D1Vac
MQAEnv       5 +Q1Vol -Q1Fe -Q1Vac
MQAFe        5 +Q1Fe -Q1Vac
MQAVac       5 +Q1Vac
#if 0
HBOX         5 +thbox -target
               -(+horn_O1 -horn_I0 -PyZhuP1 +PyZhuP2 )
               -(+horn_O0 -horn_O1 +PyZhoP -PyZhuP1  )
               -(+horn_I0 -horn_I1 -PyZhuP1  +PyZhiP1 )
#endif
#if 0
TARGET       5 +target
#endif
#if 0
HORNCo       5 +horn_O1 -horn_I0 -PyZhuP1 +PyZhuP2
               | +horn_O0 -horn_O1 +PyZhoP -PyZhuP1
               | +horn_I0 -horn_I1 -PyZhuP1  +PyZhiP1
#endif
#if 0
DECTUBE      5 +tdec
#endif
#if 0
BOX1         5 +box1
               -h00 -h01 -h02 -h03 -h04 -h05 -h06 -h07 -h08 -h09-target
#endif
#if 0
RHALUP       5 +h00-h20 -h30 -h10-target |+h30 -h10-target
               |+h01-h21 -h31 -h11-target |+h31 -h11-target
               |+h02-h22 -h32 -h12-target |+h32 -h12-target
               |+h03-h23 -h33 -h13-target |+h33 -h13-target
               |+h04-h24 -h34 -h14-target |+h34 -h14-target
               |+h05-h25 -h35 -h15-target |+h35 -h15-target
               |+h06-h26 -h36 -h16-target |+h36 -h16-target
               |+h07-h27 -h37 -h17-target |+h37 -h17-target
               |+h08-h28 -h38 -h18-target |+h38 -h18-target
               |+h09-h29 -h39 -h19-target |+h39 -h19-target
#endif
#if 0
RHBF         5 +h20-h30-target
               |+h21-h31-target
               |+h22-h32-target
               |+h23-h33-target
               |+h24-h34-target
               |+h25-h35-target
               |+h26-h36-target
               |+h27-h37-target
               |+h28-h38-target
               |+h29-h39-target
#endif
#if 0
RHALDOWN     5 +h30 -h20-target
               |+h31 -h21-target
               |+h32 -h22-target
               |+h33 -h23-target
               |+h34 -h24-target
               |+h35 -h25-target
               |+h36 -h26-target
               |+h37 -h27-target
               |+h38 -h28-target
               |+h39 -h29-target
#endif
#if 0
RHIN         5 +h10-target   |+h11-target   |+h12-target   |+h13-target  |+h14-target
               |+h15-target  |+h16 -target |+h17 -target |+h18 -target  |+h19-target
#endif
#if 0
DT           5 +dt
#endif
END
LATTICE         MBHA                          MBHA                    ttmbha
LATTICE         MQA1                          MQA1                    q1segb
GEOEND
*
* Material definitions
* --------------------
MATERIAL         19.   39.0983     0.862                              POTASSIU
MATERIAL         24.   51.9961      7.18                              CHROMIUM
MATERIAL         25. 54.938049      7.21                              MANGANES
MATERIAL         15. 30.973761      1.82                              PHOSPHO
MATERIAL         16.    32.066      2.07                              SULFUR
* Steel316LN
* Stainless steel AISI316LN
MATERIAL                             7.8                              SS316LN
COMPOUND    -0.67145      IRON    -0.185  CHROMIUM   -0.1125    NICKELSS316LN
COMPOUND       -0.02  MANGANES     -0.01   SILICON  -0.00045   PHOSPHOSS316LN
COMPOUND     -0.0003    SULFUR   -0.0003    CARBON                    SS316LN
*
* Concrete portland
* -----------------
MATERIAL                             2.3                              PORTLAND
COMPOUND       -0.01  HYDROGEN    -0.001    CARBON -0.529107    OXYGENPORTLAND
COMPOUND      -0.016    SODIUM    -0.002  MAGNESIU -0.033872  ALUMINUMPORTLAND
COMPOUND   -0.337021   SILICON    -0.013  POTASSIU    -0.044   CALCIUMPORTLAND
COMPOUND      -0.014      IRON                                        PORTLAND
ASSIGNMA    BLCKHOLE   BLKBODY                 1.0         0
ASSIGNMA      VACUUM      VOID                   1         0
ASSIGNMA        IRON    SHIELD
ASSIGNMA      HELIUM   TCC_CAV
*ASSIGNMA      HELIUM      TDEC
ASSIGNMA      HELIUM    MBHEnv
ASSIGNMA        IRON     MBHFe
ASSIGNMA      VACUUM    MBHVac
*ASSIGNMA        IRON  TDEC_SLD
*ASSIGNMA    TITANIUM    TARGET
*
* ROT-DEFI for beam line build
ROT-DEFI         300         0         0      1000         0  -$drift1ttd1
*segment B elements (after MBHA rotation)
ROT-DEFI         200            $d1_adeg                              ttsegb
!@what.6=drift1+d1_arc
ROT-DEFI                                                    539.429589ttsegb
!@what.3=mbha_adeg
*ROT-DEFI         200           mbha_adeg                              segb_angl
!@what.4=(d1_arc+drift2)*sin(d1_arad)
!@what.6=-drift1-d1_arc-(d1_arc+drift2)*cos(d1_arad)
ROT-DEFI         300                    129.299322         0-632.70059q1segb
ROT-DEFI         200           -$d1_adeg                   0          q1segb
ROT-DEFI         300                          1200                   0q1segb
!@what.4=(d1_arc+drift2+q1_len+drift3)*sin(d1_arad)
!@what.6=-drift1-d1_arc-(d1_arc+drift2+q1_len+drift3)*cos(d1_arad)
ROT-DEFI           0                    210.400529         0-691.20353q2segb
ROT-DEFI         200           -$d1_adeg                   0         0q2segb
ROT-DEFI         300                          1200                   0q2segb
*MAT-PROP           1                        VACUUM  @LASTMAT          USERDIRE
* * Activation calculations
* -----------------------
PHYSICS           3.                                                  EVAPORAT
PHYSICS           1.                                                  COALESCE
*
* Electromagnetic thresholds
* --------------------------
*         prompt     decay
*  e+/-   10 MeV    100keV
*  gamma   5 MeV     50keV
EMFCUT        -1E-05      5E-5        1.    VACUUM  @LASTMAT          PROD-CUT
EMFCUT        -1E-05      5E-5             BLKBODY  @LASTREG
*
* Photonuclear interactions
* -------------------------
PHOTONUC          1.                      BLCKHOLE  @LASTMAT
*
* Hadronic thresholds
* -------------------
PART-THR    -10.0E-6    PROTON   APROTON
PART-THR    -10.0E-6  ANEUTRON  @LASTPAR
*
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7....+....8
RANDOMIZ          1.  99999999
START         10000.                                     0.0
