*----> Beam definition
!@what.1=0.2645*tgt_rad
#define BW 0.39675
!@what.1=shift_target
#define z_beam_pos shift_target
MULSOPT
DEFAULTS                                                              NEW-DEFA
*
* Beam definition
* ---------------
*  Gaussian beam, (sigma_x, sigma_y) = (0.05cm, 0.1cm)
!@what.4=-2.3548*BW
!@what.5=-2.3548*BW
BEAM            -2.5       0.0       0.0-0.9342669-0.9342669        1.PROTON
!@what.3=z_beam_pos
BEAMPOS            0         0shift_targ       0.0       0.0
*
* Geometry
* --------
GEOBEGIN                                                              COMBNAME
    0    0          
* Black body - size 100m
SPH blkbody    0 0 0 10000
*Simulation inside this volume 10m wide, 50m long
RPP void       -1000 1000 -1000 1000 -1000 5000
*Faclity : tcc + beam to nustorm
RCC tcc        0 0 -100 0 0 1100.1 300
RCC tdec       0 0 1000 0 0 3500 $tdec_rad
*Tranlate target-horn assembly to correct position
$start_translat $tgt_x $tgt_y $tgt_z
*Target-horn box
!@what.6=1+shift_horn+h_ltot+4.0
!@what.7=h_romax+2.0
RCC thbox      0 0 -1.0 0 0 259.26 60.7
RCC target     0 0 0 0 0 $tgt_len $tgt_rad
!@what.3=h_rout1+h_thick0
ZCC horn_O0    0 0 58.7
ZCC horn_O1    0 0 $h_rout1
!@what.1=shift_horn
XYP PyZhuP1    6.1
!@what.1=shift_horn+h_thick0
XYP PyZhuP2    7.1
!@what.1=shift_horn+h_thick0+h_z1+h_z2+h_z3+h_z4+h_z5
XYP PyZhoP     227.76000000000002
!@what.3=h_rin1+h_thick
ZCC horn_I0    0 0 3.3
ZCC horn_I1    0 0 $h_rin1
!@what.1=shift_horn+h_thick+h_z1
XYP PyZhiP1    71.38000000000001
$end_translat
