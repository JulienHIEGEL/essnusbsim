# flair project file
Version: 300
Mode: fluka
md5: e290fbdbbdc6702e74d45b01af401f61
Input:
TITLE
	ESS-LEnuStorm Simulation
* General Parameters
*   beamrad : nominal beam radius to calculate apertures
#define pbeam 0.816924
#define ptline 0.7
#define beam_rad 20
#define clight 2.99792458E+10
*
* Facility
*    target chamber : 3m x 5m
*    shielding : 4m width
#define tcc_len 300
#define tcc_width 350
#define tcc_shield 400
#define tcc_o =tcc_width+tcc_shield
*
* Decay pipe
*	length = 80m
*	radius = 1m
*	shielding = 4m
#define tdec_len 8000
#define tdec_rad 250
#define tdec_shield 400
#define tdec_wid =tdec_rad+tdec_shield
*
* Beam dump
*	length 	= 5m
*	width 	= 3m
#define bdump_len 500
#define bdump_wid 300
*
* ESSnuSB near detector
*	distance (from target) = 250m
#define ndet_dis 25000
#define ndet_wid 500
*
* TTline to leNuSTORM
* -------------------
*
* Magnet prototypes
#define d1_len 221
#define d1_vlen =d1_len+0.1
#define d1_k0 0.428
#define d1_arad =d1_k0*d1_len/100
#define d1_adeg =d1_arad*180/pi
#define d1_b0 =d1_arad*ptline/clight/d1_len*1.0e13
#define d1_defl =d1_len*tan(d1_arad/2)
#define d1_pivot '=d1_len - d1_defl/tan(d1_arad)'
#define d1_apx '=d1_defl + 2*beam_rad'
#define d1_apy =2*beam_rad
#define d1_xsiz =d1_apx+60
#define d1_ysiz =d1_apy+100
#define q1_len 80
#define q1_ap 2*beam_rad*1.1
#define q1_fe 40
#define q1_rad =q1_ap+q1_fe
#define drift0 400
#define drift1 50
#define drift2 20
#define drift3 35.3
#define drift4 35.3
#define drift5 35.3
#define drift6 35.3
#define drift7 20
#define drift8 50
#define s_d1 =drift0
#define s_q1 =d1_pivot+drift1
#define s_q2 =s_q1+q1_len+drift2
#define s_q3 =s_q2+q1_len+drift3
#define s_q4 =s_q3+q1_len+drift4
#define s_q5 =s_q4+q1_len+drift5
#define s_q6 =s_q5+q1_len+drift6
#define s_q7 =s_q6+q1_len+drift7
#define s_d2 =s_q7+q1_len+drift8
*
* LEnuSTORM
*	nstorm_ss_len	= 75m
*	nstorm_tun_wid = 4m
#define nstorm_ss_len 7500
#define nstorm_tun_wid 400
*
* Target & Horn
#define thbox_rad 100
#define thbox_zmax 100
#define thbox_zmin -10
*
* Target
#define tgt_rad 1.5
#define tgt_len 78
*
*Set the defaults for precision simulations
DEFAULTS PRECISIO
*
*Define the beam characteristics
BEAM MUON+ $pbeam 0 0 2.5 2.5
*Define the beam position
BEAMPOS , 0 0 0
GEOBEGIN COMBNAME
SPH blkbody 0 0 0 100000
SPH void 0 0 0 90000
RPP tcc_o -$tcc_o $tcc_o -$tcc_o $tcc_o -100 $tcc_len
RPP tcc -$tcc_width $tcc_width -$tcc_width $tcc_width -50 =tcc_len+1
RPP tdec_o -$tdec_wid $tdec_wid -$tdec_wid $tdec_wid =tcc_len-1 =tdec_len+1
RPP tdec -$tdec_rad $tdec_rad -$tdec_rad $tdec_rad =tcc_len-2 =tdec_len-bdump_len+2
$start_transform -trttl
RPP ttline =-1.2*d1_xsiz/2 =1.2*d1_xsiz/2 =-1.2*d1_ysiz/2 =1.2*d1_ysiz/2 0 2000
$end_transform
YZP ttline_u =-tdec_rad
YZP ttline_d =-tdec_wid-1000
*Target & Horn box
RCC thbox 0 0 $thbox_zmin 0 0 $thbox_zmax $thbox_rad
RCC target 0 0 0 0 0 $tgt_len $tgt_rad
*
*---- Magnet Models -----
$start_translat -1000 0 0
RPP mbhavol =-d1_xsiz/2-0.1 =d1_xsiz/2+0.1 =-d1_ysiz/2-0.1 =d1_ysiz/2+0.1 -0.1 \
	 =d1_len+0.1
RPP mbhafe =-d1_xsiz/2 =d1_xsiz/2 =-d1_ysiz/2 =d1_ysiz/2 0 $d1_len
RPP mbhavac =-d1_apx/2 =d1_apx/2 =-d1_apy/2 =d1_apy/2 0 =d1_len
$end_translat
$start_translat -1500 0 0
RCC mqavol 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
RCC mqafe 0 0 0 0 0 $q1_len $q1_rad
RCC mqavac 0 0 -0.05 0 0 =q1_len+0.1 $q1_ap
$end_translat
*Transfer line magnets
$start_transform -trd1
$start_translat -1000 0 0
RPP D1rp =-d1_xsiz/2-0.1 =d1_xsiz/2 =-d1_ysiz/2-0.1 =d1_ysiz/2+0.1 -0.1 =d1_len+0.1
$end_translat
$end_transform
$start_transform -trd2
$start_translat -1000 0 0
RPP D2rp =-d1_xsiz/2-0.1 =d1_xsiz/2 =-d1_ysiz/2-0.1 =d1_ysiz/2+0.1 -0.1 =d1_len+0.1
$end_translat
$end_transform
$start_transform -trq1
$start_translat -1500
RCC Q1rp 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
$start_transform -trq2
$start_translat -1500
RCC Q2rp 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
$start_transform -trq3
$start_translat -1500
RCC Q3rp 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
$start_transform -trq4
$start_translat -1500
RCC Q4rp 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
$start_transform -trq5
$start_translat -1500
RCC Q5rp 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
$start_transform -trq6
$start_translat -1500
RCC Q6rp 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
$start_transform -trq7
$start_translat -1500
RCC Q7rp 0 0 -0.1 0 0 =q1_len+0.2 =q1_rad+0.1
$end_translat
$end_transform
END
REGION BLKBODY 5
	+blkbody -void
REGION VOID 5
	+void -tcc_o -tdec_o -mbhavol -mqavol -ttline -D2rp  
	@select=1
REGION SHIELD 5
	+tcc_o -tcc | +tdec_o -tcc_o -tcc -tdec -(+ttline +ttline_u)
REGION TCC_CAV 5
	(+tcc -thbox 
	| +tdec -D1rp
	| (+ttline +ttline_u)) -Q1rp -Q2rp -Q3rp -Q4rp -Q5rp -Q6rp -Q7rp -D2rp  
!REGION TCC_CAV1 5
	+tcc -thbox 
	| +tdec -D1rp
	| (+ttline +ttline_u) -Q1rp -Q2rp -Q3rp -Q4rp -Q5rp -Q6rp -Q7rp -D2
REGION THBOX 5
	+thbox -target
REGION TARGET 5
	+target
REGION MBHAEnv 5
	+mbhavol -mbhafe -mbhavac
REGION MBHAFe 5
	+mbhafe -mbhavac
REGION MBHAVac 5
	+mbhavac
REGION MQAEnv 5
	+mqavol -mqafe -mqavac
REGION MQAFe 5
	+mqafe -mqavac
REGION MQAVac 5
	+mqavac
REGION D1 5
	+D1rp 
REGION D2 5
	+D2rp 
REGION Q1 5
	+Q1rp
REGION Q2 5
	+Q2rp
REGION Q3 5
	+Q3rp 
REGION Q4 5
	+Q4rp 
REGION Q5 5
	+Q5rp 
REGION Q6 5
	+Q6rp 
REGION Q7 5
	+Q7rp 
END
LATTICE trd1 D1,,, MBHAEnv
LATTICE trd2 D2,,, MBHAEnv
LATTICE trq1 Q1,,, MQAEnv
LATTICE trq2 Q2,,, MQAEnv
LATTICE trq3 Q3,,, MQAEnv
LATTICE trq4 Q4,,, MQAEnv
LATTICE trq5 Q5,,, MQAEnv
LATTICE trq6 Q6,,, MQAEnv
LATTICE trq7 Q7,,, MQAEnv
USRBIN Beampart 10 BEAMPART -21 100 100 800 -300 -100 300 400 400 500
USRBIN Beampar1 10 BEAMPART -22 100 10 1300 -1000 -10 0 400 20 500
GEOEND
!Black body - size
*..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , VACUUM VOID
ASSIGNMA , IRON SHIELD
ASSIGNMA , HELIUM TCC_CAV
ASSIGNMA , VACUUM THBOX
ASSIGNMA , VACUUM TARGET
ASSIGNMA , HELIUM MBHAEnv
ASSIGNMA , IRON MBHAFe
ASSIGNMA , VACUUM MBHAVac,,, 1
MGNCREAT D1 2
MGNFIELD D1 =d1_b0,, 2 D1
ASSIGNMA , VACUUM MQAEnv
ASSIGNMA , IRON MQAFe
ASSIGNMA , VACUUM MQAVac
*Define the transformations from the replicas to the models
*           rot.numb.    theta    phi       dx        dy        dz
ROT-DEFI trttl 200 0.0 =-d1_adeg 0 0.0 =-(s_d1+d1_pivot)
*# ---- D1
ROT-DEFI trd1,,,, =-1000+d1_defl/2,, =-s_d1
*# ---- D2
ROT-DEFI trd2,,,, =-1000+d1_defl/2+s_d2*sin(d1_arad),, =-(s_d1+d1_pivot)-s_d2*cos(d1_arad)
*# ---- Q1
ROT-DEFI trq1 300,,, =s_q1*sin(d1_arad),, =-(s_d1+d1_pivot)-s_q1*cos(d1_arad)
ROT-DEFI trq1 200,, -$d1_adeg
ROT-DEFI trq1 300,,, -1500
*# ---- Q2
ROT-DEFI trq2 0,,, =s_q2*sin(d1_arad),, =-(s_d1+d1_pivot)-s_q2*cos(d1_arad)
ROT-DEFI trq2 200,, -$d1_adeg
ROT-DEFI trq2 300,,, -1500
*# ---- Q3
ROT-DEFI trq3 0,,, =s_q3*sin(d1_arad),, =-(s_d1+d1_pivot)-s_q3*cos(d1_arad)
ROT-DEFI trq3 200,, -$d1_adeg
ROT-DEFI trq3 300,,, -1500
*# ---- Q4
ROT-DEFI trq4 0,,, =s_q4*sin(d1_arad),, =-(s_d1+d1_pivot)-s_q4*cos(d1_arad)
ROT-DEFI trq4 200,, -$d1_adeg
ROT-DEFI trq4 300,,, -1500
*# ---- Q5
ROT-DEFI trq5 0,,, =s_q5*sin(d1_arad),, =-(s_d1+d1_pivot)-s_q5*cos(d1_arad)
ROT-DEFI trq5 200,, -$d1_adeg
ROT-DEFI trq5 300,,, -1500
*# ---- Q6
ROT-DEFI trq6 0,,, =s_q6*sin(d1_arad),, =-(s_d1+d1_pivot)-s_q6*cos(d1_arad)
ROT-DEFI trq6 200,, -$d1_adeg
ROT-DEFI trq6 300,,, -1500
*# ---- Q7
ROT-DEFI trq7 0,,, =s_q7*sin(d1_arad),, =-(s_d1+d1_pivot)-s_q7*cos(d1_arad)
ROT-DEFI trq7 200,, -$d1_adeg
ROT-DEFI trq7 300,,, -1500
*Set the random number seed
RANDOMIZ , 1.0
*Set the number of primary histories to be simulated in the run
START , 1000
STOP
EndInput

