TITLE
TTLINE pion beam 0.7 GeV
!#define primary 0
*
* General Parameters
*   beamrad : nominal beam radius to calculate apertures
#define pbeam 0.7
#define ptline 0.7
#define beam_rad 20
#define clight 29979245800
*
* Facility
*    target chamber : 3m x 5m
*    shielding : 4m width
#define tcc_len 300
#define tcc_width 350
#define tcc_shield 400
#define tcc_o 750
*
* Decay pipe
*	length = 80m
*	radius = 1m
*	shielding = 4m
#define tdec_len 8000
#define tdec_rad 250
#define tdec_shield 400
#define tdec_wid 650
*
* Beam dump
*	length 	= 5m
*	width 	= 3m
#define bdump_len 500
#define bdump_wid 300
*
* ESSnuSB near detector
*	distance (from target) = 250m
#define ndet_dis 25000
#define ndet_wid 500
*
* TTline to leNuSTORM
* -------------------
*
* Magnet prototypes
#define d1_len 120.3517
#define d1_vlen 120.4517
#define d1_k0 0.428275
#define d1_arad 0.515436243175
#define d1_adeg 29.53232134200628
#define d1_b0 1.00000014009692
#define d1_defl 31.72226000131154
#define d1_pivot 64.35652123102876
#define d1_apx 71.72226000131154
#define d1_apy 40
#define d1_xsiz 131.7222600013116
#define d1_ysiz 140
#define q1_len 80
#define q1_ap 44
#define q1_fe 40
#define q1_rad 84
#define drift0 200
#define drift1 50
#define drift2 20
#define drift3 35.3
#define drift4 35.3
#define drift5 35.3
#define drift6 35.3
#define drift7 20
#define drift8 50
#define s_d1 200
#define s_q1 114.3565212310288
#define s_q2 214.3565212310288
#define s_q3 329.6565212310288
#define s_q4 444.9565212310288
#define s_q5 560.2565212310287
#define s_q6 675.5565212310287
#define s_q7 775.5565212310287
#define s_d2 905.5565212310287
*
* LEnuSTORM
*	nstorm_ss_len	= 75m
*	nstorm_tun_wid = 4m
#define nstorm_ss_len 7500
#define nstorm_tun_wid 400
*
* Target & Horn
#define thbox_rad 100
#define thbox_zmax 100
#define thbox_zmin -10
*
* Target
#define tgt_rad 1.5
#define tgt_len 78
*
*Set the defaults for precision simulations
DEFAULTS                                                              PRECISIO
FREE
*
*Define the beam characteristics
#ifdef primary
BEAM      , -2.5, 0, 0, 2.5, 2.5,  ,MUON+
#else
BEAM      , $pbeam, 0, 0, 2.5, 2.5,  ,MUON+
#endif
*Define the beam position
BEAMPOS   , 0, 0, 0
GEOBEGIN   ,  ,  ,  ,  ,  ,  , COMBNAME
0,0,
SPH blkbody    0 0 0 100000
SPH void       0 0 0 90000
RPP tcc_o      -$tcc_o $tcc_o -$tcc_o $tcc_o -100 $tcc_len
RPP tcc        -$tcc_width $tcc_width -$tcc_width $tcc_width -50 301
RPP tdec_o     -$tdec_wid $tdec_wid -$tdec_wid $tdec_wid 299 8001
RPP tdec       -$tdec_rad $tdec_rad -$tdec_rad $tdec_rad 298 $tdec_len
*$start_transform -trttl
#if 0
RPP ttline     -79.03335600078692 79.03335600078692 -84 84 0 2000
#endif
*$end_transform
#if 0
YZP ttline_u   -$tdec_rad
#endif
#if 0
YZP ttline_d   -1650
#endif
*Target & Horn box
RCC thbox      0 0 $thbox_zmin 0 0 $thbox_zmax $thbox_rad
RCC target     0 0 0 0 0 $tgt_len $tgt_rad
*
*---- Models and Tunnels bodies ----
*
RCC parko      0.0 0.0 -13300.0 0 0 3600.0 1200
RCC parki      0.0 0.0 -13100.0 0 0 3200.0 1000
$start_transform tltnl
RPP tltuno     -350 400.0 -400.0 400.0 -100 2624.129840055357
RPP tltun      -150 200.0 -200.0 200.0 -100 2524.129840055357
$end_transform
$start_transform rgtnl
RPP rgtnlo     -776.045126715897 776.0451267158968 -300.0 300.0 -300
              12247.61796755497
RPP rgtnli     -676.045126715897 676.0451267158968 -200.0 200.0 -200
              12147.61796755497
$end_transform
RPP dumpo      -240.0 240.0 -240.0 240.0 850.0 1450.0
RPP dumpc      -116.717882233719 24.0 -24.0 24.0 850.0 950.0
*
*---- LEnuSTORM magnet models bodies  ----
*
$start_translat 0 0 -10100
RPP ttmbvol    -90.5034226133921 90.50342261339205 -40.1 40.1 -0.1
              115.193019028711
RPP ttmbfe     -90.4034226133921 90.40342261339205 -40.0 40.0 0 115.093019028711
RPP ttmbvac    -60.4034226133921 60.40342261339206 -12.0 12.0 -0.1
              115.193019028711
$end_translat
$start_translat 0 0 -10400
RPP ttmqvol    -39.1 39.1 -39.1 39.1 -0.1 80.1
