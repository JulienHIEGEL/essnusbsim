#if 0
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7...
*
TITLE
ESSnuSB Beam to LEnuSTORM
#endif
*-----
*GEOMETRY parameters
*-----
* Facility
* --------
* Target chamber
* 	length = -1m to +3m = 4ms
* 	width  = 2.5m
* 	shielding width = 4m
#define tcc_len 300
#define tcc_width 250
#define tcc_shield 400
!@what.1=tcc_width+tcc_shield
#define tcc_o 650
*
* Decay pipe
*	length = 80m
*	radius = 1m
*	shielding = 4m
#define tdec_len 8000
#define tdec_rad 100
#define tdec_shield 400
!@what.1=tdec_rad+tdec_shield
#define tdec_wid 500
*
* Beam dump
*	length 	= 5m
*	width 	= 3m
#define bdump_len 500
#define bdump_wid 300
*
* ESSnuSB near detector
*	distance (from target) = 250m
#define ndet_dis 25000
#define ndet_wid 500
*
* TTline to leNuSTORM
* -------------------
*
* Magnet prototypes
#define d1_len 221
#define d1_k0 0.428
!@what.1=d1_k0*d1_len/100
#define d1_arad 0.94588
!@what.1=d1_arad*180/pi
#define d1_adeg 54.1949319258343
!@what.1=d1_arad*0.7/299.79/d1_len*1.0e5
#define d1_b0 0.999366223022783
!@what.1=0.5*sin(d1_arad)*d1_len
#define d1_apx 89.616834136162
!@what.1=40
#define d1_apy 40
!@what.1=d1_apx*1.20
#define d1_xsiz 107.5402009633944
!@what.1=d1_apy*1.20
#define d1_ysiz 48
!@what.1=d1_len/2/cos(d1_arad/2)**2
#define d1_arc 139.429589070911
#define q1_len 80
#define q1_ap 40
#define q1_fe 20
!@what.1=q1_ap+q1_fe
#define q1_rad 60
#define drift1 400
#define drift2 20
#define drift3 20
#define drift4 35.3
#define drift5 35.3
#define drift6 35.3
#define drift7 35.3
#define drift8 20
#define drift9 20
!@what.1=drift2
#define s_q1 20
!@what.1=s_q1+q1_len+drift3
#define s_q2 120
!@what.1=s_q2+q1_len+drift4
#define s_q3 235.3
!@what.1=s_q3+q1_len+drift5
#define s_q4 350.6
!@what.1=s_q4+q1_len+drift6
#define s_q5 465.9
!@what.1=s_q5+q1_len+drift7
#define s_q6 581.2
!@what.1=s_q6+q1_len+drift8
#define s_q7 681.2
!@what.1=s_q7+q1_len+drift9
#define s_d2 781.2
*
* LEnuSTORM
*	nstorm_ss_len	= 75m
*	nstorm_tun_wid = 4m
#define nstorm_ss_len 7500
#define nstorm_tun_wid 400
*
* Target & Horn
#define thbox_rad 100
#define thbox_zmax 100
#define thbox_zmin -10
*
* Target
#define tgt_rad 1.5
#define tgt_len 78
*
* Horn
#define hon_zmin 6.1
#define h_thick0 1
#define h_thick 0.3
#define h_z1 64.98
#define h_z2 46.8
#define h_z3 60.3
#define h_z4 47.5
#define h_z5 1.08
#define h_z6 5.44
#define h_z7 5.44
#define h_z8 5.44
#define h_z9 5.44
#define h_z10 5.74
!@what.1=h_z1+h_z2+h_z3+h_z4+h_z5+h_z6+h_z7+h_z8+h_z9+h_z10
#define h_ltot 248.16
#define h_rin1 3
#define h_rin2 22.1
#define h_rin3 3.54
#define h_rin4 5.24
#define h_rin5 8.37
#define h_rin6 13.86
#define h_rin7 30.5
#define h_rout1 57.7
#define h_rout2 57.15
#define h_rout3 55.43
#define h_rout4 52.26
#define h_rout5 46.82
#define h_rout6 30.5
!@what.1=57.7+h_thick0
#define h_romax 58.7
!@what.1=h_rin1
#define h_rimin 3
* ---------
MULSOPT
DEFAULTS                                                              NEW-DEFA
*Beam definition
* ---------------
*  Gaussian beam, 2.5GeV, (sigma_x, sigma_y) = (0.05cm, 0.1cm)
BEAM            -0.7       0.0       0.0         0         0       1.0PROTON
BEAMPOS            0         0         0       0.0       0.0
*
* Geometry
* --------
GEOBEGIN                                                              COMBNAME
    0    0          
* Black body - size 100m
SPH blkbody    0 0 0 100000
SPH void       0 0 0 90000
RPP tcc_o      -$tcc_o $tcc_o -$tcc_o $tcc_o -100 $tcc_len
!@what.6=tcc_len+1
RPP tcc        -$tcc_width $tcc_width -$tcc_width $tcc_width -50 301
!@what.5=tcc_len-1
!@what.6=tdec_len+1
RPP tdec_o     -$tdec_wid $tdec_wid -$tdec_wid $tdec_wid 299 8001
!@what.3=tcc_len-2
!@what.6=tdec_len-bdump_len+2
RCC tdec       0 0 298 0 0 7502 $tdec_rad
*Target & Horn box
RCC thbox      0 0 $thbox_zmin 0 0 $thbox_zmax $thbox_rad
RCC target     0 0 0 0 0 $tgt_len $tgt_rad
END
* Black hole
BLKBODY      5 +blkbody -void
VOID         5 +void -tcc_o -tdec_o
SHIELD       5 +tcc_o -tcc
               | +tdec_o -tcc_o -tcc -tdec
TCC_CAV      5 +tcc -thbox
               | +tdec
#if 0
TDEC         5 +tdec -tcc -MBHA
#endif
THBOX        5 +thbox -target
TARGET       5 +target
END
*
GEOEND
*
ASSIGNMA    BLCKHOLE   BLKBODY                 1.0         0
ASSIGNMA      VACUUM      VOID                   1         0
ASSIGNMA        IRON    SHIELD
ASSIGNMA      VACUUM   TCC_CAV
ASSIGNMA    TITANIUM    TARGET
ASSIGNMA      VACUUM     THBOX
*
USRBIN                BEAMPART       -21        50        50      2000Beampart
USRBIN           -50       -50      -100        10        10       100 &
*
*
*MAT-PROP           1                        VACUUM  @LASTMAT          USERDIRE
* * Activation calculations
* -----------------------
*PHYSICS           3.                                                  EVAPORAT
*PHYSICS           1.                                                  COALESCE
*
* Electromagnetic thresholds
* --------------------------
*         prompt     decay
*  e+/-   10 MeV    100keV
*  gamma   5 MeV     50keV
*EMFCUT        -1E-05      5E-5        1.    VACUUM  @LASTMAT          PROD-CUT
*EMFCUT        -1E-05      5E-5             BLKBODY  @LASTREG
*
* Photonuclear interactions
* -------------------------
*PHOTONUC          1.                      BLCKHOLE  @LASTMAT
*
* Hadronic thresholds
* -------------------
*PART-THR    -10.0E-6    PROTON   APROTON
*PART-THR    -10.0E-6  ANEUTRON  @LASTPAR
*
* ..+....1....+....2....+....3....+....4....+....5....+....6....+....7....+....8
RANDOMIZ          1.1.12233E13
START          1000.                                     0.0
STOP
