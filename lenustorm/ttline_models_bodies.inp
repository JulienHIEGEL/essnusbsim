*
* --- Transfer line magnet model bodies
*
$start_translat -1000 0 0
!@what.1=-d1_xsiz/2-0.1
!@what.2=d1_xsiz/2+0.1
!@what.3=-d1_ysiz/2-0.1
!@what.4=d1_ysiz/2+0.1
!@what.6=d1_len+0.1
RPP mbhavol    -106.6395400789188 106.6395400789188 -70.1 70.1 -0.1 221.1
!@what.1=-d1_xsiz/2
!@what.2=d1_xsiz/2
!@what.3=-d1_ysiz/2
!@what.4=d1_ysiz/2
RPP mbhafe     -106.5395400789188 106.5395400789188 -70 70 0 $d1_len
!@what.1=-d1_apx/2
!@what.2=d1_apx/2
!@what.3=-d1_apy/2
!@what.4=d1_apy/2
RPP mbhavac    -76.5395400789188 76.5395400789188 -20 20 0 $d1_len
$end_translat
$start_translat -1500 0 0
!@what.6=q1_len+0.2
!@what.7=q1_rad+0.1
RCC mqavol     0 0 -0.1 0 0 80.2 84.1
RCC mqafe      0 0 0 0 0 $q1_len $q1_rad
!@what.6=q1_len+0.1
RCC mqavac     0 0 -0.05 0 0 80.1 $q1_ap
$end_translat